{
  "id": "soma-blobs-gate",
  "name": "soma-blobs-gate",
  "connector_type": "storage",
  "tags": ["soma", "conn", "matches"],
  "config": {
    "type": "storage",
    "provider": "s3",
    "endpoint": "env://RUNNER_BLOB_ENDPOINT",
    "region": "auto",
    "bucket": "env://R2_BUCKET",
    "access_key": "env://R2_ACCESS_KEY",
    "secret_key": "env://R2_SECRET_KEY",
    "force_path_style": true,
    "operations": { "presign_get": false, "presign_put": true, "head": false },
    "allow_private_urls": "var://allow_private_urls"
  }
}
