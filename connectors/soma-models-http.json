{
  "id": "soma-models-http",
  "name": "soma-models-http",
  "connector_type": "http",
  "tags": ["soma", "conn", "models"],
  "config": {
    "type": "http",
    "url": "env://MODELS_ENDPOINT",
    "headers": { "user-agent": "soma-admit" },
    "retry": { "max_retries": 1, "retry_delay_ms": 500 },
    "timeout_ms": 30000,
    "allow_private_urls": "var://allow_private_urls"
  }
}
