{
  "id": "soma-db",
  "name": "soma-db",
  "connector_type": "db",
  "tags": ["soma", "conn", "platform"],
  "config": {
    "type": "db",
    "connection_string": "env://SOMA_DB_URL",
    "max_connections": "var://db_max_connections",
    "connect_timeout_ms": "var://db_connect_timeout_ms",
    "query_timeout_ms": 15000,
    "operations": { "delete": false },
    "allow_private_urls": "var://allow_private_urls"
  }
}
