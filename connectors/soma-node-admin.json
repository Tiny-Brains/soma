{
  "id": "soma-node-admin",
  "name": "soma-node-admin",
  "connector_type": "http",
  "tags": ["pkg:soma"],
  "config": {
    "type": "http",
    "url": "http://127.0.0.1:8080/api/v1/admin",
    "headers": {
      "content-type": "application/json",
      "user-agent": "soma-admit",
      "authorization": "env://ORION_ADMIN_BEARER"
    },
    "retry": { "max_retries": 0, "retry_delay_ms": 0 },
    "timeout_ms": 180000
  }
}
