{
  "id": "soma-models",
  "name": "soma-models",
  "connector_type": "storage",
  "tags": ["pkg:soma"],
  "config": {
    "type": "storage",
    "provider": "s3",
    "endpoint": "env://MODELS_PUBLIC_ENDPOINT",
    "region": "auto",
    "bucket": "env://MODELS_BUCKET",
    "access_key": "env://R2_ACCESS_KEY",
    "secret_key": "env://R2_SECRET_KEY",
    "force_path_style": true,
    "operations": { "presign_get": false, "presign_put": true, "head": true },
    "allow_private_urls": "var://allow_private_urls"
  }
}
