{
  "id": "soma-db-gate",
  "name": "soma-db-gate",
  "connector_type": "db",
  "tags": ["soma", "conn", "matches"],
  "config": {
    "type": "db",
    "connection_string": "env://RUNNER_GATE_DB_URL",
