# Orion server config for Soma. Requires orion-server >= 1.5.0.
# Copy to orion.toml and fill in. Every value here is instance config, not part of
# the package -- channels and workflows carry no environment of their own.
#
# Check it before starting:  orion-server -c orion.toml validate-config

[server]
host = "0.0.0.0"
port = 8080

# Soma's channels declare route_pattern as "/v1/...". The data plane is always
# mounted at /api/v1/data; this makes those same patterns answer at /v1/... too.
#
# NOTE the mount does NOT get prepended to route_pattern -- the full request path
# is matched against the pattern, so the "/v1" prefix must appear in BOTH places.
# A channel with route_pattern "/v1/games" then answers at:
#     /v1/games                    (via this mount)
#     /api/v1/data/v1/games        (canonical, always)
data_mounts = ["/v1"]

# Orion's own state: channels, workflows, connectors, traces, audit.
# This is NOT Soma's data, though it may share the server.
#
# It must be durable. The default is a SQLite file in ./orion.db, which is wrong
# on Cloudflare Containers -- disk there is ephemeral and a restart loses every
# channel definition. Point it at Postgres.
# NOTE this one value does NOT take env:// — storage.url is parsed as a database
# URL and an env:// string fails the scheme check at boot ("Unsupported database
# URL scheme"). Set it literally here, or leave the section out and pass
# ORION_STORAGE__URL in the environment, which is what server/dev-load.sh assumes.
[storage]
url = "postgres://user:pass@host:5432/orion_state"

# Traced, visible in responses and workflow context. Non-secret only.
#
# A workflow reads one as {"var": "metadata.vars.name"}. Since 1.5.0 a stored
# connector or channel config can also read one as "var://name", which keeps the
# value's type -- worth knowing if Soma ever needs a per-instance TTL or rate
# limit on a channel. Soma declares none today: its channels are identical in
# every environment.
[vars]
github_client_id   = "Iv1.xxxxxxxxxxxxxxxx"
oauth_redirect_uri = "https://tinybrains.dev/v1/auth/github/callback"
app_url            = "https://tinybrains.dev/"

# Engine-held. Referenced as {"secret": "name"} and never appears in a trace,
# a response, or a map result.
#
# 1.5.0 widened where one resolves: crypto.key and jwt_sign.key are now ordinary
# JSONLogic, so a secret can be composed rather than only named, and a channel
# guard's *_logic may read one too. Soma uses the plain form -- the callback
# workflow's client_secret -- which is unchanged.
[secrets]
github_client_secret = "env://GITHUB_CLIENT_SECRET"

# Governs the portable data dialect (data_query / data_write). Soma reaches
# Postgres through raw db_read instead, so these do not bind its endpoints --
# the leaderboard's own LIMIT is the ceiling that applies. Set anyway, so a
# dialect task added later inherits sane numbers.
[query]
default_limit = 50
max_limit     = 200

# Kafka-heavy deployments want async here; Soma is REST-only and low volume.
[trace_storage]
mode = "async"
