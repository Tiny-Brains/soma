{
  "channel_id": "soma-user-participants-add",
  "name": "soma-user-participants-add",
  "description": "Add logins to a season's roster in bulk. Season admins and platform admins.",
  "tags": ["soma", "user", "seasons"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["POST"],
  "route_pattern": "/v1/games/{game}/seasons/{slug}/participants",
  "workflow_id": "soma-user-participants-add",
  "config": {
    "request": { "$from": "constants.payload_body" },
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_write_rate" }
  }
}
