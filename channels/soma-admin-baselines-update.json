{
  "channel_id": "soma-admin-baselines-update",
  "name": "soma-admin-baselines-update",
  "description": "Enables or disables a baseline. Disabled is off the ladder with its rating kept.",
  "tags": ["soma", "admin", "baselines"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["PATCH"],
  "route_pattern": "/v1/games/{game}/seasons/{slug}/baselines/{baseline}",
  "workflow_id": "soma-admin-baselines-update",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 20000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_admin_board_rate" }
  }
}
