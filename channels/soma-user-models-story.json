{
  "channel_id": "soma-user-models-story",
  "name": "soma-user-models-story",
  "description": "The writer's view of a model's story, held edit included. session_auth, never cached.",
  "tags": ["soma", "user", "community"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["GET"],
  "route_pattern": "/v1/me/models/{id}/story",
  "workflow_id": "soma-user-models-story",
  "config": {
    "request": { "$from": "constants.payload_body" },
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_read_rate" }
  }
}
