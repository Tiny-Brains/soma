{
  "channel_id": "soma-user-me",
  "name": "soma-user-me",
  "description": "The signed-in competitor's own record. session_auth: it answers about whoever holds the session, so it takes no id and can leak nothing by guessing one.",
  "tags": ["soma", "user", "profile"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["GET"],
  "route_pattern": "/v1/me",
  "workflow_id": "soma-user-me",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_read_rate" }
  }
}
