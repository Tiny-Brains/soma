{
  "channel_id": "soma-pub-events",
  "name": "soma-pub-events",
  "description": "Counts one watch event. No auth, address rate limit, never cached.",
  "tags": ["soma", "pub", "matches"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["POST"],
  "route_pattern": "/v1/events",
  "workflow_id": "soma-pub-events",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.public_rate" }
  }
}
