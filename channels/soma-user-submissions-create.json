{
  "channel_id": "soma-user-submissions-create",
  "name": "soma-user-submissions-create",
  "description": "Takes the hashes of an ONNX file and its manifest and answers presigned PUTs. The PUTs are signed for the PUBLIC endpoint, which is not the one a node fetches by.",
  "tags": ["soma", "user", "models"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["POST"],
  "route_pattern": "/v1/submissions",
  "workflow_id": "soma-user-submissions-create",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_write_rate" }
  }
}
