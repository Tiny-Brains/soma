{
  "channel_id": "soma-user-private-maps-get",
  "name": "soma-user-private-maps-get",
  "description": "The member's read of one board, whole, for the viewer to draw. Cached on `season`, invalidated by the same writes as the list. Signed in and uncached: it answers a private season to whoever may see it.",
  "tags": ["soma", "user", "maps"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["GET"],
  "route_pattern": "/v1/private/games/{game}/seasons/{slug}/maps/{map_id}",
  "workflow_id": "soma-user-private-maps-get",
  "config": {
    "request": { "$from": "constants.payload_body" },
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_read_rate" }
  }
}
