{
  "channel_id": "soma-admin-runners-revoke",
  "name": "soma-admin-runners-revoke",
  "description": "Revokes one replica. Its live claims are left to lapse and the reap clock returns them.",
  "tags": ["soma", "admin", "runners"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["DELETE"],
  "route_pattern": "/v1/runners/{id}",
  "workflow_id": "soma-admin-runners-revoke",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_write_rate" }
  }
}
