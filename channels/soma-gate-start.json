{
  "channel_id": "soma-gate-start",
  "name": "soma-gate-start",
  "description": "Claimed becomes running. Fenced on the claim token, and answers `started` so a runner whose lease was reaped learns it here.",
  "tags": ["soma", "gate", "matches"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["POST"],
  "route_pattern": "/v1/runner/matches/{id}/start",
  "workflow_id": "soma-gate-start",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.runner_rate" },
    "auth": { "$from": "constants.runner_auth" },
    "principal_rate_limit": { "$from": "constants.per_runner_rate" }
  }
}
