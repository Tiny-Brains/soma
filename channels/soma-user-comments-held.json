{
  "channel_id": "soma-user-comments-held",
  "name": "soma-user-comments-held",
  "description": "Signed in and never cached: the caller's own held comments on one host.",
  "tags": ["soma", "user", "community"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["GET"],
  "route_pattern": "/v1/me/comments",
  "workflow_id": "soma-user-comments-held",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_read_rate" }
  }
}
