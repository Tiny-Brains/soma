{
  "channel_id": "soma-sessions-revoke",
  "name": "soma-sessions-revoke",
  "tags": ["pkg:soma"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["DELETE"],
  "route_pattern": "/v1/sessions/{sid}",
  "workflow_id": "soma-sessions-revoke",
  "config": {
    "response": { "$from": "constants.shaped", "cookies": true },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_read_rate" }
  }
}
