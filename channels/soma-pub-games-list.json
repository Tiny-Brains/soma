{
  "channel_id": "soma-pub-games-list",
  "name": "soma-pub-games-list",
  "description": "The game catalogue. season_cache, not hot_cache: this answer changes when an admin creates or closes a season, not when a match is rated.",
  "tags": ["soma", "pub", "platform"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["GET"],
  "route_pattern": "/v1/games",
  "workflow_id": "soma-pub-games-list",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.public_rate" },
    "cache": { "$from": "constants.season_cache" }
  }
}
