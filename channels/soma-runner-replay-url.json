{
  "channel_id": "soma-runner-replay-url",
  "name": "soma-runner-replay-url",
  "tags": ["pkg:soma"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["POST"],
  "route_pattern": "/v1/runner/matches/{id}/replay-url",
  "workflow_id": "soma-runner-replay-url",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.runner_rate" },
    "auth": { "$from": "constants.runner_auth" },
    "principal_rate_limit": { "$from": "constants.per_runner_rate" }
  }
}
