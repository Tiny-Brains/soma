{
  "channel_id": "soma-admin-seasons-feature",
  "name": "soma-admin-seasons-feature",
  "description": "Makes a public season the game's featured one, what every 'no season' read resolves to.",
  "tags": ["soma", "admin", "seasons"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["POST"],
  "route_pattern": "/v1/games/{game}/seasons/{slug}/featured",
  "workflow_id": "soma-admin-seasons-feature",
  "config": {
    "request": { "$from": "constants.payload_body" },
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_write_rate" }
  }
}
