{
  "channel_id": "soma-admin-picks-create",
  "name": "soma-admin-picks-create",
  "description": "Pins a match to Staff picks. Admin, per-user write rate.",
  "tags": ["soma", "admin", "matches"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["POST"],
  "route_pattern": "/v1/admin/picks",
  "workflow_id": "soma-admin-picks-create",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_write_rate" }
  }
}
