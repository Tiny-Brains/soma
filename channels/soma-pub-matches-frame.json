{
  "channel_id": "soma-pub-matches-frame",
  "name": "soma-pub-matches-frame",
  "description": "A card's resting picture: the last frame. hot_cache, and the workflow tells the browser to keep a frame for good.",
  "tags": ["soma", "pub", "matches"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["GET"],
  "route_pattern": "/v1/matches/{id}/frame",
  "workflow_id": "soma-pub-matches-frame",
  "config": {
    "request": { "$from": "constants.payload_body" },
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.public_rate" },
    "cache": { "$from": "constants.hot_cache", "namespaces": ["matches"] }
  }
}
