{
  "channel_id": "soma-user-session-delete",
  "name": "soma-user-session-delete",
  "description": "Signs this session out. DELETE on /v1/session -- this one, not a named one, which is why it takes no id.",
  "tags": ["soma", "user", "auth"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["DELETE"],
  "route_pattern": "/v1/session",
  "workflow_id": "soma-user-session-delete",
  "config": {
    "response": { "$from": "constants.shaped", "cookies": true },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_read_rate" }
  }
}
