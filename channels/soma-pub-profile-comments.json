{
  "channel_id": "soma-pub-profile-comments",
  "name": "soma-pub-profile-comments",
  "description": "Public and cached: an author's live comments, newest first.",
  "tags": ["soma", "pub", "profile"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["GET"],
  "route_pattern": "/v1/profiles/{username}/comments",
  "workflow_id": "soma-pub-profile-comments",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.public_rate" },
    "cache": { "$from": "constants.hot_cache" }
  }
}
