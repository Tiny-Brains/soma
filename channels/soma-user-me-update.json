{
  "channel_id": "soma-user-me-update",
  "name": "soma-user-me-update",
  "description": "Edits the signed-in competitor's own profile. Its own path rather than a parameter on the admin route, so no id is ever accepted here.",
  "tags": ["soma", "user", "profile"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["PATCH"],
  "route_pattern": "/v1/me",
  "workflow_id": "soma-user-me-update",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_read_rate" }
  }
}
