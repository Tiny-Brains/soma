{
  "channel_id": "soma-pub-picks",
  "name": "soma-pub-picks",
  "description": "Staff picks: the pinned cards. hot_cache.",
  "tags": ["soma", "pub", "matches"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["GET"],
  "route_pattern": "/v1/games/{game}/picks",
  "workflow_id": "soma-pub-picks",
  "config": {
    "request": { "$from": "constants.payload_body" },
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.public_rate" },
    "cache": { "$from": "constants.hot_cache", "namespaces": ["community", "matches"] }
  }
}
