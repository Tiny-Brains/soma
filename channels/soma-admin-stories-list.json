{
  "channel_id": "soma-admin-stories-list",
  "name": "soma-admin-stories-list",
  "description": "Every model story with its state. Admin, never cached.",
  "tags": ["soma", "admin", "community"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["GET"],
  "route_pattern": "/v1/admin/stories",
  "workflow_id": "soma-admin-stories-list",
  "config": {
    "request": { "$from": "constants.payload_body" },
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_read_rate" }
  }
}
