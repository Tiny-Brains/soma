{
  "channel_id": "soma-user-models-update",
  "name": "soma-user-models-update",
  "description": "Edits a model's own fields. Nothing here touches a version's status: that is the admit clock's alone.",
  "tags": ["soma", "user", "models"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["PATCH"],
  "route_pattern": "/v1/models/{id}",
  "workflow_id": "soma-user-models-update",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_write_rate" }
  }
}
