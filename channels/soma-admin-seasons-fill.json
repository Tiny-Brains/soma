{
  "channel_id": "soma-admin-seasons-fill",
  "name": "soma-admin-seasons-fill",
  "description": "Turns a season's idle fill on or off and sets its games per version and lane headroom, while the season is live. Platform admin only.",
  "tags": ["soma", "admin", "seasons"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["PATCH"],
  "route_pattern": "/v1/games/{game}/seasons/{slug}/fill",
  "workflow_id": "soma-admin-seasons-fill",
  "config": {
    "request": { "$from": "constants.payload_body" },
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_write_rate" }
  }
}
