{
  "channel_id": "soma-pub-announcements",
  "name": "soma-pub-announcements",
  "description": "The live announcements. season_cache: an admin's change reaches every reader within a minute.",
  "tags": ["soma", "pub", "platform"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["GET"],
  "route_pattern": "/v1/announcements",
  "workflow_id": "soma-pub-announcements",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.public_rate" },
    "cache": { "$from": "constants.season_cache" }
  }
}
