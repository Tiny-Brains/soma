{
  "channel_id": "soma-admin-seasons-rounds-create",
  "name": "soma-admin-seasons-rounds-create",
  "description": "Schedules a score reset or, once the window has closed, the finals: kind, start, games per entry, sigma floor, mu shrink and the countdown's lead. Platform admin.",
  "tags": ["soma", "admin", "seasons"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["POST"],
  "route_pattern": "/v1/games/{game}/seasons/{slug}/rounds",
  "workflow_id": "soma-admin-seasons-rounds-create",
  "config": {
    "request": { "$from": "constants.payload_body" },
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_write_rate" }
  }
}
