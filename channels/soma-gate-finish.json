{
  "channel_id": "soma-gate-finish",
  "name": "soma-gate-finish",
  "description": "Finishes the row in one statement, on the token. Binds `data.req.result` and `data.req.engine_digest`: a runner sending other names binds nulls and gets 409 claim_lost.",
  "tags": ["soma", "gate", "matches"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["POST"],
  "route_pattern": "/v1/runner/matches/{id}/finish",
  "workflow_id": "soma-gate-finish",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.runner_rate" },
    "auth": { "$from": "constants.runner_auth" },
    "principal_rate_limit": { "$from": "constants.per_runner_rate" }
  }
}
