{
  "channel_id": "soma-pub-threads",
  "name": "soma-pub-threads",
  "description": "Public and cached: a thread's live comments. Caller-invariant, so the author's held rows are GET /v1/me/comments.",
  "tags": ["soma", "pub", "community"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["GET"],
  "route_pattern": "/v1/threads",
  "workflow_id": "soma-pub-threads",
  "config": {
    "request": { "$from": "constants.payload_body" },
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.public_rate" },
    "cache": { "$from": "constants.hot_cache", "namespaces": ["community"] }
  }
}
