{
  "channel_id": "soma-admin-notify-send",
  "name": "soma-admin-notify-send",
  "description": "Sends a notification to an audience at once. Admin, per-user write rate.",
  "tags": ["soma", "admin", "notifications"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["POST"],
  "route_pattern": "/v1/admin/notify",
  "workflow_id": "soma-admin-notify-send",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_write_rate" }
  }
}
