{
  "channel_id": "soma-user-submissions-reenter",
  "name": "soma-user-submissions-reenter",
  "description": "Re-enters an entry into a season with its version from an earlier one: no upload, a new version admitted again under the season's rules.",
  "tags": ["soma", "user", "models"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["POST"],
  "route_pattern": "/v1/submissions/reenter",
  "workflow_id": "soma-user-submissions-reenter",
  "config": {
    "request": { "$from": "constants.payload_body" },
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_write_rate" }
  }
}
