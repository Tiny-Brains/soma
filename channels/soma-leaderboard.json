{
  "channel_id": "soma-leaderboard",
  "name": "soma-leaderboard",
  "tags": ["pkg:soma"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["GET"],
  "route_pattern": "/v1/games/{game}/leaderboard",
  "workflow_id": "soma-leaderboard",
  "config": {
    "response": { "mode": "shaped" },
    "timeout_ms": 10000,
    "rate_limit": {
      "requests_per_second": 30,
      "burst": 60
    },
    "cache": {
      "enabled": true,
      "ttl_secs": 10,
      "connector": "soma-cache"
    }
  }
}
