{
  "channel_id": "soma-pub-stories",
  "name": "soma-pub-stories",
  "description": "The Stories list: the team's posts and featured model stories. Public and cached.",
  "tags": ["soma", "pub", "community"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["GET"],
  "route_pattern": "/v1/stories",
  "workflow_id": "soma-pub-stories",
  "config": {
    "request": { "$from": "constants.payload_body" },
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.public_rate" },
    "cache": { "$from": "constants.hot_cache", "namespaces": ["community"] }
  }
}
