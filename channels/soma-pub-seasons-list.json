{
  "channel_id": "soma-pub-seasons-list",
  "name": "soma-pub-seasons-list",
  "description": "A game's seasons, past and live. season_cache: a closed season's row never changes again.",
  "tags": ["soma", "pub", "seasons"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["GET"],
  "route_pattern": "/v1/games/{game}/seasons",
  "workflow_id": "soma-pub-seasons-list",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.public_rate" },
    "cache": { "$from": "constants.season_cache" }
  }
}
