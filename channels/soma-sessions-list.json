{
  "channel_id": "soma-sessions-list",
  "name": "soma-sessions-list",
  "tags": [
    "pkg:soma"
  ],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": [
    "GET"
  ],
  "route_pattern": "/v1/sessions",
  "workflow_id": "soma-sessions-list",
  "config": {
    "response": {
      "mode": "shaped"
    },
    "timeout_ms": 10000,
    "auth": {
      "mode": "jwt",
      "algorithms": [
        "HS256"
      ],
      "jwt_keys": [
        {
          "algorithm": "HS256",
          "key": "env://SOMA_SESSION_SECRET"
        }
      ],
      "issuer": "soma",
      "source": {
        "cookie": "soma_session"
      }
    },
    "principal_rate_limit": {
      "requests_per_second": 10,
      "burst": 20,
      "key_logic": {
        "var": "auth.sub"
      }
    }
  }
}
