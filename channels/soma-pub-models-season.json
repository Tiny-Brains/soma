{
  "channel_id": "soma-pub-models-season",
  "name": "soma-pub-models-season",
  "description": "One model's season. hot_cache.",
  "tags": ["soma", "pub", "models"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["GET"],
  "route_pattern": "/v1/models/{id}/season",
  "workflow_id": "soma-pub-models-season",
  "config": {
    "request": { "$from": "constants.payload_body" },
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.public_rate" },
    "cache": { "$from": "constants.hot_cache", "namespaces": ["ladder", "matches"] }
  }
}
