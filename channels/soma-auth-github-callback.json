{
  "channel_id": "soma-auth-github-callback",
  "name": "soma-auth-github-callback",
  "tags": [
    "pkg:soma"
  ],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": [
    "GET"
  ],
  "route_pattern": "/v1/auth/github/callback",
  "workflow_id": "soma-auth-github-callback",
  "config": {
    "response": {
      "mode": "shaped",
      "allowed_headers": [
        "location"
      ],
      "cookies": true
    },
    "timeout_ms": 10000,
    "request": {
      "cookies_to_metadata": [
        "soma_oauth_state"
      ]
    }
  }
}
