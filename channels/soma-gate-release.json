{
  "channel_id": "soma-gate-release",
  "name": "soma-gate-release",
  "description": "Returns a claimed row to the queue -- what a runner calls when it cannot serve a seat's model.",
  "tags": ["soma", "gate", "matches"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["POST"],
  "route_pattern": "/v1/runner/matches/{id}/release",
  "workflow_id": "soma-gate-release",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.runner_rate" },
    "auth": { "$from": "constants.runner_auth" },
    "principal_rate_limit": { "$from": "constants.per_runner_rate" },
    "tracing": { "$from": "constants.gate_tracing" }
  }
}
