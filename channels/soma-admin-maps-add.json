{
  "channel_id": "soma-admin-maps-add",
  "name": "soma-admin-maps-add",
  "description": "Uploads a board into a season. 20s rather than 10: this runs the engine's own worldgen on the file and checks it against the cartridge's limits before storing it, disabled.",
  "tags": ["soma", "admin", "maps"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["POST"],
  "route_pattern": "/v1/games/{game}/seasons/{slug}/maps",
  "workflow_id": "soma-admin-maps-add",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 20000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_admin_board_rate" }
  }
}
