{
  "channel_id": "soma-user-sessions-list",
  "name": "soma-user-sessions-list",
  "description": "Every live session this competitor holds, so a stolen one can be seen.",
  "tags": ["soma", "user", "auth"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["GET"],
  "route_pattern": "/v1/sessions",
  "workflow_id": "soma-user-sessions-list",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_read_rate" }
  }
}
