{
  "channel_id": "soma-admin-users-update",
  "name": "soma-admin-users-update",
  "description": "Promotes or demotes a user. The other way in is SOMA_ADMIN_GITHUB_IDS, which promotes at sign-in.",
  "tags": ["soma", "admin", "users"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["PATCH"],
  "route_pattern": "/v1/admin/users/{id}",
  "workflow_id": "soma-admin-users-update",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_write_rate" }
  }
}
