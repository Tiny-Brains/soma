{
  "channel_id": "soma-admin-posts-update",
  "name": "soma-admin-posts-update",
  "description": "Saves, publishes or unpublishes a post. Admin, per-user write rate.",
  "tags": ["soma", "admin", "community"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["PATCH"],
  "route_pattern": "/v1/admin/posts/{id}",
  "workflow_id": "soma-admin-posts-update",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_write_rate" }
  }
}
