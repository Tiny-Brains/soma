{
  "channel_id": "soma-gate-claim",
  "name": "soma-gate-claim",
  "tags": ["soma", "gate", "matches"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["POST"],
  "route_pattern": "/v1/runner/claim",
  "workflow_id": "soma-gate-claim",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.runner_rate" },
    "auth": { "$from": "constants.runner_auth" },
    "principal_rate_limit": { "$from": "constants.per_runner_rate" },
    "tracing": { "$from": "constants.gate_tracing" }
  }
}
