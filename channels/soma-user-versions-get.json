{
  "channel_id": "soma-user-versions-get",
  "name": "soma-user-versions-get",
  "description": "One of the caller's own versions, whatever its status: the in-flight and rejected versions the public route answers 404 for. session_auth, and never cached.",
  "tags": ["soma", "user", "models"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["GET"],
  "route_pattern": "/v1/me/versions/{id}",
  "workflow_id": "soma-user-versions-get",
  "config": {
    "request": { "$from": "constants.payload_body" },
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_read_rate" }
  }
}
