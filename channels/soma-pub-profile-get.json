{
  "channel_id": "soma-pub-profile-get",
  "name": "soma-pub-profile-get",
  "description": "A competitor's public profile by username. hot_cache.",
  "tags": ["soma", "pub", "profile"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["GET"],
  "route_pattern": "/v1/profiles/{username}",
  "workflow_id": "soma-pub-profile-get",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.public_rate" },
    "cache": { "$from": "constants.hot_cache" }
  }
}
