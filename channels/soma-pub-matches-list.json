{
  "channel_id": "soma-pub-matches-list",
  "name": "soma-pub-matches-list",
  "description": "The recent matches feed. hot_cache: it is append-mostly and every visitor asks for it.",
  "tags": ["soma", "pub", "matches"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["GET"],
  "route_pattern": "/v1/matches",
  "workflow_id": "soma-pub-matches-list",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.public_rate" },
    "cache": { "$from": "constants.hot_cache" }
  }
}
