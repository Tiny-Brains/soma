{
  "channel_id": "soma-pub-podium",
  "name": "soma-pub-podium",
  "description": "A season's frozen podium. season_cache under `season` alone: the close writes it and bumps `season`, and a live season has none, so no fold changes it.",
  "tags": ["soma", "pub", "ladder"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["GET"],
  "route_pattern": "/v1/games/{game}/seasons/{slug}/podium",
  "workflow_id": "soma-pub-podium",
  "config": {
    "request": { "$from": "constants.payload_body" },
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.public_rate" },
    "cache": { "$from": "constants.season_cache", "namespaces": ["season"] }
  }
}
