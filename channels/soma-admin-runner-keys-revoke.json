{
  "channel_id": "soma-admin-runner-keys-revoke",
  "name": "soma-admin-runner-keys-revoke",
  "description": "Revokes a runner key. A runner holding it fails its next token exchange, not its current match.",
  "tags": ["soma", "admin", "runners"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["DELETE"],
  "route_pattern": "/v1/runner-keys/{id}",
  "workflow_id": "soma-admin-runner-keys-revoke",
  "config": {
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_write_rate" }
  }
}
