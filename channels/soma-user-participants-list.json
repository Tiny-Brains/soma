{
  "channel_id": "soma-user-participants-list",
  "name": "soma-user-participants-list",
  "description": "A season's participant roster, for its season admins and platform admins only.",
  "tags": ["soma", "user", "seasons"],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": ["GET"],
  "route_pattern": "/v1/games/{game}/seasons/{slug}/participants",
  "workflow_id": "soma-user-participants-list",
  "config": {
    "request": { "$from": "constants.payload_body" },
    "response": { "$from": "constants.shaped" },
    "timeout_ms": 10000,
    "rate_limit": { "$from": "constants.session_rate" },
    "auth": { "$from": "constants.session_auth" },
    "principal_rate_limit": { "$from": "constants.per_user_read_rate" }
  }
}
