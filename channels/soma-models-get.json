{
  "channel_id": "soma-models-get",
  "name": "soma-models-get",
  "tags": [
    "pkg:soma"
  ],
  "channel_type": "sync",
  "protocol": "rest",
  "methods": [
    "GET"
  ],
  "route_pattern": "/v1/games/{game}/models/{owner}/{repo}",
  "workflow_id": "soma-models-get",
  "config": {
    "response": {
      "mode": "shaped"
    },
    "timeout_ms": 10000,
    "rate_limit": {
      "requests_per_second": 30,
      "burst": 60
    },
    "cache": {
      "enabled": true,
      "ttl_secs": 10,
      "connector": "soma-cache"
    }
  }
}
