{
  "workflow_id": "soma-auth-github-start",
  "name": "Begin GitHub sign-in",
  "tags": [
    "pkg:soma"
  ],
  "condition": true,
  "tasks": [
    {
      "id": "nonce",
      "name": "Mint a per-attempt nonce",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            {
              "path": "temp_data.nonce",
              "logic": {
                "random": [
                  "uuid"
                ]
              }
            }
          ]
        }
      }
    },
    {
      "id": "state",
      "name": "Mint a signed state token",
      "function": {
        "name": "jwt_sign",
        "input": {
          "algorithm": "HS256",
          "key": "env://SOMA_SESSION_SECRET",
          "claims": {
            "purpose": "oauth-state",
            "nonce": {
              "var": "temp_data.nonce"
            }
          },
          "issuer": "soma-oauth",
          "expires_in": "10m",
          "output": "temp_data.state"
        }
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            {
              "path": "data.body",
              "logic": {}
            },
            {
              "path": "data._orion.response",
              "logic": {
                "status": 302,
                "body_path": "data.body",
                "headers": {
                  "location": {
                    "cat": [
                      "https://github.com/login/oauth/authorize?scope=read%3Auser&client_id=",
                      {
                        "var": "metadata.vars.github_client_id"
                      },
                      "&redirect_uri=",
                      {
                        "var": "metadata.vars.oauth_redirect_uri"
                      },
                      "&state=",
                      {
                        "var": "temp_data.state"
                      }
                    ]
                  }
                },
                "cookies": [
                  {
                    "name": "soma_oauth_state",
                    "value": {
                      "var": "temp_data.state"
                    },
                    "path": "/",
                    "http_only": true,
                    "secure": true,
                    "same_site": "Lax",
                    "max_age": 600
                  }
                ]
              }
            }
          ]
        }
      }
    }
  ],
  "description": "The state token is both the cookie and the query parameter; the callback requires them to match. The nonce is what makes each token unique: jwt_sign's other claims are constant and iat/exp have one-second granularity, so without it two sign-ins starting in the same second produced byte-identical tokens and the state value identified nothing. It is computed in a map task because jwt_sign.claims folds {\"var\": ...} and no other operator -- see orion-gaps.md N1. This stands in for PKCE, which the shared-token design cannot express."
}
