{
  "workflow_id": "soma-sessions-revoke",
  "name": "End one session, or all the others",
  "tags": [
    "pkg:soma"
  ],
  "condition": true,
  "description": "SOMA-GAPS 1.3, the acting half. {sid} names one session to end; the literal `others` ends every session but the one asking, which is `Sign out everywhere` written honestly -- it cannot log you out of the browser you are holding, so it does not claim to. THE OWNERSHIP CHECK IS THE WHERE CLAUSE, not a guard task: the UPDATE matches only rows whose user_id is the caller's, so a sid belonging to somebody else touches nothing and answers 404 -- the same answer as a sid that does not exist, which is the point. Revoking an already-dead session is also a 404 rather than a lie about having done something. The session doing the asking is verified first and separately, so `nothing was revoked` and `you are not signed in` never arrive as the same status.",
  "tasks": [
    {
      "id": "who",
      "name": "Verify the caller",
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": "SELECT ls.sid AS session_ok FROM live_sessions ls WHERE ls.sid = ($2)::uuid AND ls.user_id = ($1)::uuid",
          "params": [
            {
              "var": "metadata.auth.claims.sub"
            },
            {
              "var": "metadata.auth.claims.sid"
            }
          ],
          "output": "temp_data.rows"
        }
      }
    },
    {
      "id": "deny",
      "name": "Reject a revoked session",
      "condition": {
        "!": {
          "var": "temp_data.rows.0.session_ok"
        }
      },
      "terminal": true,
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            {
              "path": "data.body",
              "logic": {
                "error": "session_revoked"
              }
            },
            {
              "path": "data._orion.response",
              "logic": {
                "status": 401,
                "body_path": "data.body"
              }
            }
          ]
        }
      }
    },
    {
      "id": "revoke",
      "name": "Revoke",
      "function": {
        "name": "db_write",
        "input": {
          "connector": "soma-db",
          "query": "UPDATE sessions s SET revoked_at = now() WHERE s.user_id = ($1)::uuid AND s.revoked_at IS NULL AND s.expires_at > now() AND CASE WHEN ($3)::text = 'others' THEN s.sid <> ($2)::uuid ELSE s.sid = ($3)::uuid END",
          "params": [
            {
              "var": "metadata.auth.claims.sub"
            },
            {
              "var": "metadata.auth.claims.sid"
            },
            {
              "var": "metadata.params.sid"
            }
          ],
          "output": "temp_data.revoked"
        }
      }
    },
    {
      "id": "nothing",
      "name": "Nothing to revoke",
      "condition": {
        "and": [
          {
            "!=": [
              {
                "var": "metadata.params.sid"
              },
              "others"
            ]
          },
          {
            "!": {
              ">": [
                {
                  "var": "temp_data.revoked.rows_affected"
                },
                0
              ]
            }
          }
        ]
      },
      "terminal": true,
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            {
              "path": "data.body",
              "logic": {
                "error": "unknown_session"
              }
            },
            {
              "path": "data._orion.response",
              "logic": {
                "status": 404,
                "body_path": "data.body"
              }
            }
          ]
        }
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            {
              "path": "data.body.revoked",
              "logic": {
                "var": "temp_data.revoked.rows_affected"
              }
            },
            {
              "path": "data._orion.response",
              "logic": {
                "status": 200,
                "body_path": "data.body"
              }
            }
          ]
        }
      }
    }
  ]
}
