{
  "workflow_id": "soma-seasons-create",
  "name": "Create a season",
  "description": "Admin only. ONE STATEMENT creates the season -- its NAME and the slug season_slug() derives from it, both fixed for ever, number last+1 as an internal ordinal, the engine pinned from games.active_engine_digest, the window and the whole rules document. Refusals, told apart by `why`: a name that gives no usable slug, a slug another season holds, a season still live, an opening inside season_gap_days of the previous close, or no engine declared. The season opens with NO MAPS AND NO BASELINES: both are uploaded to it afterwards, land out of play, and are put in play by hand -- and until a baseline is enabled no trial can be seated, so every candidate waits. A create used to carry the previous season's baselines forward as new version rows, and since their bucket key is generated from the version id every carried key was empty; a season's baselines are its own uploads now, and a name used again is the same baseline account with a new version. PARTICIPANT HANDLES ARE STORED AS GIVEN and resolved at each submission, not here: a cohort is a list of GitHub logins written before the term starts and most of its members have never signed in, so resolving once and keeping only the ids would refuse exactly those people for the whole season. The ids that DO resolve are stored beside them as the fast path, and the handles that do not come back in the response as information. The list accepts an array or one comma-separated string. WEIGHT CLASSES ARE THE SEASON'S: absent from the body it inherits the previous season's table rather than a constant.",
  "tags": ["pkg:soma"],
  "tasks": [
    {
      "id": "parse",
      "name": "Parse payload",
      "function": { "name": "parse_json", "input": { "source": "payload", "target": "req" } }
    },
    {
      "id": "who",
      "name": "Who is asking",
      "function": { "name": "db_read", "input": { "$from": "constants.admin_identity" } }
    },
    {
      "id": "deny",
      "use": "deny-revoked",
      "with": { "row": "temp_data.who.0.body" }
    },
    {
      "id": "forbid",
      "use": "refuse",
      "with": {
        "when": { "!=": [{ "var": "temp_data.who.0.body.role" }, "admin"] },
        "status": 403,
        "body": { "error": "admin_only" },
        "name": "Admins only",
        "description": "The role is read off the live session rather than off a claim in the cookie, so revoking a session or demoting a user takes effect on the next request."
      }
    },
    {
      "id": "named",
      "use": "refuse",
      "with": {
        "when": { "!": { "var": "data.req.name" } },
        "status": 400,
        "body": {
          "error": "name_required",
          "detail": "A season is named when it is created -- \"Summer 2026\" -- and its slug, summer-2026, is how every link addresses it. Neither can be changed later."
        },
        "name": "A name, declared"
      }
    },
    {
      "id": "dates",
      "use": "refuse",
      "with": {
        "when": {
          "or": [
            { "!": { "var": "data.req.submissions_open_at" } },
            { "!": { "var": "data.req.submissions_close_at" } }
          ]
        },
        "status": 400,
        "body": {
          "error": "dates_required",
          "detail": "submissions_open_at and submissions_close_at are required, as ISO-8601 timestamps."
        },
        "name": "Both dates, declared"
      }
    },
    {
      "id": "rules",
      "name": "Take the rules as given",
      "function": {
        "name": "map",
        "input": {
          "mappings": [{ "path": "temp_data.rules", "logic": { "var": "data.req.rules" } }]
        }
      }
    },
    {
      "id": "participants",
      "name": "Resolve participant handles to ids",
      "condition": { "!!": { "var": "data.req.rules.participants.handles" } },
      "tasks": [
        {
          "id": "resolve",
          "name": "Look the handles up",
          "function": {
            "name": "db_read",
            "input": {
              "connector": "soma-db",
              "query": { "$sql": "../sql/soma-seasons-create-resolve.sql" },
              "params": [{ "var": "data.req.rules.participants.handles" }],
              "output": "temp_data.resolved"
            }
          }
        },
        {
          "id": "listed",
          "name": "Put the handles and the ids the rule",
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                {
                  "path": "temp_data.rules.participants.handles",
                  "logic": { "var": "temp_data.resolved.0.handles" }
                },
                {
                  "path": "temp_data.rules.participants.user_ids",
                  "logic": { "var": "temp_data.resolved.0.ids" }
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "create",
      "name": "Create the season",
      "function": {
        "name": "db_write",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-seasons-create-create.sql" },
          "params": [
            { "var": "metadata.params.game" },
            { "var": "data.req.submissions_open_at" },
            { "var": "data.req.submissions_close_at" },
            { "var": "metadata.vars.season_gap_days" },
            { "var": "temp_data.rules" },
            { "var": "data.req.weight_classes" },
            { "var": "data.req.name" }
          ],
          "output": "temp_data.created"
        }
      }
    },
    {
      "id": "why",
      "name": "Why nothing was created",
      "condition": { "!": { ">": [{ "var": "temp_data.created.rows_affected" }, 0] } },
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-seasons-create-why.sql" },
          "params": [
            { "var": "metadata.params.game" },
            { "var": "metadata.vars.season_gap_days" },
            { "var": "data.req.name" }
          ],
          "output": "temp_data.why"
        }
      }
    },
    {
      "id": "unknown",
      "use": "refuse",
      "with": {
        "when": {
          "and": [
            { "!": { ">": [{ "var": "temp_data.created.rows_affected" }, 0] } },
            { "!": { "var": "temp_data.why.0.body" } }
          ]
        },
        "status": 404,
        "body": { "error": "unknown_game" },
        "name": "No such game"
      }
    },
    {
      "id": "unusable",
      "use": "refuse",
      "with": {
        "when": {
          "and": [
            { "!": { ">": [{ "var": "temp_data.created.rows_affected" }, 0] } },
            { "===": [{ "var": "temp_data.why.0.body.name_usable" }, false] }
          ]
        },
        "status": 400,
        "body": {
          "error": "season_name_unusable",
          "detail": "A name is 1 to 48 characters and must leave a slug -- letters and digits, joined by hyphens -- that is not current, live, latest or new.",
          "slug": { "var": "temp_data.why.0.body.slug" }
        },
        "name": "A name that makes a slug"
      }
    },
    {
      "id": "refused",
      "use": "refuse",
      "with": {
        "when": { "!": { ">": [{ "var": "temp_data.created.rows_affected" }, 0] } },
        "status": 409,
        "body": {
          "error": {
            "if": [
              { "!!": { "var": "temp_data.why.0.body.taken_by" } },
              "season_slug_taken",
              { "!!": { "var": "temp_data.why.0.body.live" } },
              "season_live",
              { "!": { "var": "temp_data.why.0.body.engine" } },
              "no_engine",
              "inside_gap"
            ]
          },
          "detail": { "var": "temp_data.why.0.body" }
        },
        "name": "Refused"
      }
    },
    {
      "id": "read",
      "name": "Read the season back",
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": "SELECT season_json(s) AS body FROM games g, current_season(g.id) s WHERE g.slug = ($1)::text",
          "params": [{ "var": "metadata.params.game" }],
          "output": "temp_data.rows"
        }
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            { "path": "data.body", "logic": { "var": "temp_data.rows.0.body" } },
            { "path": "data._orion.response", "logic": { "$from": "constants.created" } }
          ]
        }
      }
    }
  ]
}
