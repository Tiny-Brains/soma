{
  "workflow_id": "soma-user-comments-create",
  "name": "Post a comment",
  "description": "A COMMENT OR A REPLY on a match or a model: `{match | model, parent?, body}`. The host's thread is made on its first comment. THE POST IS ONE STATEMENT WITH EVERY RULE A PREDICATE, so a refusal is a row never written and `why` reads the reason back through the same functions (line_ok, thread_host_ok, comment_wait, the commenting switch); each refusal below is one of those answers. Every state counts toward both limits, so deleting and posting again resets neither. HELD, NOT REFUSED, on a listed word or a link: the author sees it marked `held` and nobody else does until an admin approves it. The thread's live count is the trigger's. 201 with the comment as its author sees it. Then, only for a live comment and each allowed to fail: a `reply` to the parent's author and a `comment` to the host's owners, read off the row.",
  "tags": ["soma", "user", "community"],
  "tasks": [
    {
      "id": "parse",
      "name": "Parse payload",
      "function": { "name": "parse_json", "input": { "source": "payload", "target": "req" } }
    },
    {
      "id": "host",
      "use": "refuse",
      "with": {
        "when": {
          "==": [{ "!!": { "var": "data.req.match" } }, { "!!": { "var": "data.req.model" } }]
        },
        "status": 400,
        "body": {
          "error": "host_required",
          "detail": "Name exactly one host: `match` or `model`."
        },
        "name": "Exactly one host"
      }
    },
    {
      "id": "name",
      "name": "Name the comment",
      "description": "The id is minted here so the read-back and the notifications can name the row the post wrote.",
      "function": {
        "name": "map",
        "input": { "mappings": [{ "path": "temp_data.cid", "logic": { "random": ["uuid"] } }] }
      }
    },
    {
      "id": "thread",
      "name": "Make the host's thread",
      "function": {
        "name": "db_write",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-community-shared-thread.sql" },
          "params": [
            { "var": "metadata.auth.claims.sub" },
            { "var": "metadata.auth.claims.sid" },
            { "var": "data.req.match" },
            { "var": "data.req.model" }
          ],
          "output": "temp_data.thread"
        }
      }
    },
    {
      "id": "post",
      "name": "Post it",
      "function": {
        "name": "db_write",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-user-comments-create-post.sql" },
          "params": [
            { "var": "metadata.auth.claims.sub" },
            { "var": "metadata.auth.claims.sid" },
            { "var": "data.req.match" },
            { "var": "data.req.model" },
            { "var": "data.req.parent" },
            { "var": "data.req.body" },
            { "var": "temp_data.cid" }
          ],
          "output": "temp_data.posted"
        }
      }
    },
    {
      "id": "why",
      "name": "Why nothing was written",
      "condition": { "!": { ">": [{ "var": "temp_data.posted.rows_affected" }, 0] } },
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-user-comments-create-why.sql" },
          "params": [
            { "var": "metadata.auth.claims.sub" },
            { "var": "metadata.auth.claims.sid" },
            { "var": "data.req.match" },
            { "var": "data.req.model" },
            { "var": "data.req.parent" },
            { "var": "data.req.body" }
          ],
          "output": "temp_data.why"
        }
      }
    },
    {
      "id": "revoked",
      "use": "refuse",
      "with": {
        "when": {
          "and": [
            { "!": { ">": [{ "var": "temp_data.posted.rows_affected" }, 0] } },
            { "!": { "var": "temp_data.why.0.session_ok" } }
          ]
        },
        "status": 401,
        "body": { "error": "session_revoked" },
        "name": "A live session"
      }
    },
    {
      "id": "body",
      "use": "refuse",
      "with": {
        "when": {
          "and": [
            { "!": { ">": [{ "var": "temp_data.posted.rows_affected" }, 0] } },
            { "!": { "var": "temp_data.why.0.body.body_ok" } }
          ]
        },
        "status": 400,
        "body": {
          "error": "body_invalid",
          "detail": "A comment is one line of plain text, not blank, at most 500 characters."
        },
        "name": "One line of text"
      }
    },
    {
      "id": "host_unknown",
      "use": "refuse",
      "with": {
        "when": {
          "and": [
            { "!": { ">": [{ "var": "temp_data.posted.rows_affected" }, 0] } },
            { "!": { "var": "temp_data.why.0.body.host_ok" } }
          ]
        },
        "status": 404,
        "body": { "error": "unknown_host" },
        "name": "A host anyone may see"
      }
    },
    {
      "id": "parent",
      "use": "refuse",
      "with": {
        "when": {
          "and": [
            { "!": { ">": [{ "var": "temp_data.posted.rows_affected" }, 0] } },
            { "!": { "var": "temp_data.why.0.body.parent_ok" } }
          ]
        },
        "status": 404,
        "body": { "error": "unknown_parent" },
        "name": "A live parent in this thread"
      }
    },
    {
      "id": "off",
      "use": "refuse",
      "with": {
        "when": {
          "and": [
            { "!": { ">": [{ "var": "temp_data.posted.rows_affected" }, 0] } },
            { "!!": { "var": "temp_data.why.0.body.off_until" } }
          ]
        },
        "status": 403,
        "body": {
          "error": "commenting_off",
          "until": { "var": "temp_data.why.0.body.off_until" },
          "reason": { "var": "temp_data.why.0.body.off_reason" }
        },
        "name": "Commenting switched off"
      }
    },
    {
      "id": "locked",
      "use": "refuse",
      "with": {
        "when": {
          "and": [
            { "!": { ">": [{ "var": "temp_data.posted.rows_affected" }, 0] } },
            { "var": "temp_data.why.0.body.locked" }
          ]
        },
        "status": 409,
        "body": { "error": "thread_locked" },
        "name": "An open thread"
      }
    },
    {
      "id": "limit",
      "name": "Too soon",
      "description": "A refusal of its own rather than the `refuse` fragment, so the 429 carries Retry-After as a header as well as in the body. comment_wait() sets `wait_s` (fifteen seconds apart) or `day_wait_s` (a hundred a day); the first that is set answers.",
      "condition": {
        "and": [
          { "!": { ">": [{ "var": "temp_data.posted.rows_affected" }, 0] } },
          {
            "or": [
              { "!!": { "var": "temp_data.why.0.body.wait_s" } },
              { "!!": { "var": "temp_data.why.0.body.day_wait_s" } }
            ]
          }
        ]
      },
      "terminal": true,
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            {
              "path": "data.body",
              "logic": {
                "error": {
                  "if": [
                    { "!!": { "var": "temp_data.why.0.body.wait_s" } },
                    "too_fast",
                    "daily_limit"
                  ]
                },
                "retry_after": {
                  "or": [
                    { "var": "temp_data.why.0.body.wait_s" },
                    { "var": "temp_data.why.0.body.day_wait_s" }
                  ]
                },
                "detail": {
                  "if": [
                    { "!!": { "var": "temp_data.why.0.body.wait_s" } },
                    "One comment every fifteen seconds.",
                    "A hundred comments a day."
                  ]
                }
              }
            },
            { "path": "data._orion.response.status", "logic": 429 },
            { "path": "data._orion.response.body_path", "logic": "data.body" },
            {
              "path": "data._orion.response.headers.Retry-After",
              "logic": {
                "cat": [
                  {
                    "or": [
                      { "var": "temp_data.why.0.body.wait_s" },
                      { "var": "temp_data.why.0.body.day_wait_s" }
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "id": "refused",
      "use": "refuse",
      "with": {
        "when": { "!": { ">": [{ "var": "temp_data.posted.rows_affected" }, 0] } },
        "status": 409,
        "body": { "error": "comment_refused", "detail": { "var": "temp_data.why.0.body" } },
        "name": "Refused",
        "description": "A race the reads above cannot name: the thread was locked or the switch thrown between the post and the diagnosis."
      }
    },
    {
      "id": "read",
      "name": "Read it back",
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-user-comments-create-read.sql" },
          "params": [{ "var": "temp_data.cid" }, { "var": "metadata.auth.claims.sub" }],
          "output": "temp_data.rows"
        }
      }
    },
    {
      "id": "notify",
      "name": "Tell whom it concerns",
      "description": "Only after a post that wrote; each notifier reads the comment off its row, sends nothing for a held one, and may fail without failing the post.",
      "condition": { ">": [{ "var": "temp_data.posted.rows_affected" }, 0] },
      "tasks": [
        {
          "id": "notify_reply",
          "name": "Tell the parent's author",
          "continue_on_error": true,
          "function": {
            "name": "db_write",
            "input": {
              "connector": "soma-db",
              "query": { "$sql": "../sql/soma-community-shared-notify_reply.sql" },
              "params": [{ "var": "temp_data.cid" }, null],
              "output": "temp_data.notified_reply"
            }
          }
        },
        {
          "id": "notify_comment",
          "name": "Tell the host's owners",
          "continue_on_error": true,
          "function": {
            "name": "db_write",
            "input": {
              "connector": "soma-db",
              "query": { "$sql": "../sql/soma-community-shared-notify_comment.sql" },
              "params": [{ "var": "temp_data.cid" }, null],
              "output": "temp_data.notified_comment"
            }
          }
        }
      ]
    },
    {
      "id": "respond",
      "name": "Respond",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            { "path": "data.body", "logic": { "var": "temp_data.rows.0.body" } },
            { "path": "data._orion.response", "logic": { "$from": "constants.created" } }
          ]
        }
      }
    }
  ]
}
