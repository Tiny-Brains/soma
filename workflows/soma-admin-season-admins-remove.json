{
  "workflow_id": "soma-admin-season-admins-remove",
  "name": "Remove a season admin",
  "description": "A PLATFORM admin (admin-only) removes a season admin by platform handle. A soft remove: the membership can be re-added, and R3 ends any runner key the removed admin holds for this season at its next call. 404 when no live membership matches. The response is the season's admins after the removal.",
  "tags": ["soma", "admin", "seasons"],
  "tasks": [
    {
      "id": "parse",
      "name": "Parse payload",
      "function": { "name": "parse_json", "input": { "source": "payload", "target": "req" } }
    },
    {
      "id": "admin",
      "use": "admin-only"
    },
    {
      "id": "declared",
      "use": "refuse",
      "with": {
        "when": { "!": { "var": "data.req.handle" } },
        "status": 400,
        "body": {
          "error": "handle_required",
          "detail": "Give the platform handle to remove in `handle`."
        },
        "name": "A handle, declared"
      }
    },
    {
      "id": "remove",
      "name": "Remove the season admin",
      "function": {
        "name": "db_write",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-admin-season-admins-remove-remove.sql" },
          "params": [
            { "var": "metadata.params.game" },
            { "var": "metadata.params.slug" },
            { "var": "data.req.handle" },
            { "var": "metadata.auth.claims.sub" }
          ],
          "output": "temp_data.removed"
        }
      }
    },
    {
      "id": "gone",
      "use": "refuse",
      "with": {
        "when": { "$use": "none_written", "with": { "slot": "removed" } },
        "status": 404,
        "body": {
          "error": "unknown_season_admin",
          "detail": "No live season admin with that handle in this season."
        },
        "name": "No such season admin"
      }
    },
    {
      "id": "refresh",
      "name": "Refresh the removed account's session",
      "description": "Only when a live membership was removed. /v1/me carries admin_of and is served from the session entry, so the removed account's generation is bumped, hard, and its entry re-read on the next load -- and R3 ends any runner key it held for this season at the next call. The season-scoped routes re-check the membership live regardless.",
      "condition": { ">": [{ "var": "temp_data.removed.rows_affected" }, 0] },
      "tasks": [
        {
          "id": "resolve",
          "name": "The removed account",
          "function": {
            "name": "db_read",
            "input": {
              "connector": "soma-db",
              "query": "SELECT u.id AS user_id FROM users u WHERE lower(u.handle) = lower(($1)::text)",
              "params": [{ "var": "data.req.handle" }],
              "output": "temp_data.removed_user"
            }
          }
        },
        {
          "id": "bump_sess",
          "use": "bump",
          "with": {
            "key": { "cat": ["gen:sess:", { "var": "temp_data.removed_user.0.user_id" }] },
            "soft": false
          }
        },
        {
          "id": "notify",
          "name": "Tell the account it no longer runs the season",
          "description": "A notification is never part of the statement that decided the thing: its own continue_on_error write after it, reading the decision off the row.",
          "continue_on_error": true,
          "function": {
            "name": "db_write",
            "input": {
              "connector": "soma-db",
              "query": { "$sql": "../sql/soma-admin-season-admins-remove-notify.sql" },
              "params": [
                { "var": "metadata.params.game" },
                { "var": "metadata.params.slug" },
                { "var": "data.req.handle" }
              ],
              "output": "temp_data.notify"
            }
          }
        }
      ]
    },
    {
      "id": "read",
      "name": "Read the admins back",
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-admin-shared-season-admins.sql" },
          "params": [{ "var": "metadata.params.game" }, { "var": "metadata.params.slug" }],
          "output": "temp_data.rows"
        }
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            { "path": "data.body", "logic": { "var": "temp_data.rows.0.body" } },
            { "path": "data._orion.response", "logic": { "$from": "constants.ok" } }
          ]
        }
      }
    }
  ]
}
