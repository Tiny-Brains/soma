{
  "workflow_id": "soma-clock-count-run",
  "name": "Clock: count",
  "description": "The only writer of a ladder. Claims its run fence at the first task and halts if it lost, then walks one document of work: every unmarked finished match in finish order, followed by every trial that has reached a terminal state. A fold is one plugin call and one fenced statement; a verdict is promotion (two statements) or rejection or nothing at all. Folds come first so a trial is decided after every result that arrived before it. A fold that affects zero rows reads why: the fence moved, so the run halts and the next occurrence starts from a clean read; or the row is still finished under a live fence, a posterior that did not cover every seat and ladder the row has, which is logged and passed over so one such row never stops the ladder. A pass that affects zero rows does not halt: a concurrent run decided the candidate, and the withdraw after it is idempotent. The loop runs one sweep per item of the batch (`loop.over`), with the fence, the batch read and its halt in `loop.setup` and every per-item slot in a scratch the engine empties before each sweep; `max` is a bound, never the terminator, and `held` is the early one. Each fold, pass and rejection is followed by its notification -- a separate, keyed, continue_on_error statement that reads the decision off the row, so a notification can be lost to a crash between the two but never costs a fold or a verdict.",
  "tags": ["soma", "clock", "ladder"],
  "condition": true,
  "loop": {
    "counter": "i",
    "max": 400,
    "over": { "??": [{ "var": "temp_data.rows.0.body.items" }, []] },
    "as": "it",
    "scratch": "s",
    "setup": [
      {
        "id": "probe",
        "name": "Read the generation and this poller's marker",
        "description": "One MGET, soft, BEFORE the fence: `gen:finished` moves with every finish, release, reap and withdraw, and `idle:count` holds the generation under which the last run's batch was empty. Equal means nothing has finished since: the tick is skipped, and the fence is never taken. A Redis that cannot answer runs the clock.",
        "continue_on_error": true,
        "function": {
          "name": "cache_read",
          "input": {
            "connector": "soma-cache",
            "keys": ["gen:finished", "idle:count"],
            "output": "temp_data.gen"
          }
        }
      },
      {
        "id": "generation",
        "use": "generation"
      },
      {
        "id": "fresh",
        "name": "Skip the tick while nothing has finished",
        "description": "A skipped tick delays nothing and decides nothing: every result to count arrives through a write that bumps the generation, and the marker's 60 s TTL is the backstop.",
        "function": {
          "name": "filter",
          "input": {
            "condition": {
              "!": {
                "and": [
                  { "!==": [{ "var": "temp_data.gen.1" }, null] },
                  { "==": [{ "var": "temp_data.generation" }, { "var": "temp_data.gen.1" }] }
                ]
              }
            },
            "on_reject": "halt"
          }
        }
      },
      {
        "id": "fence",
        "name": "Claim the run fence",
        "function": {
          "name": "db_write",
          "input": {
            "connector": "soma-db",
            "query": { "$sql": "../sql/soma-clock-count-run-fence.sql" },
            "params": [
              { "var": "metadata.trigger.scheduled_for" },
              { "var": "metadata.trigger.attempt" }
            ],
            "output": "temp_data.fence"
          }
        }
      },
      {
        "id": "fenced",
        "name": "Halt if a newer run holds it",
        "function": {
          "name": "filter",
          "input": {
            "condition": { ">": [{ "var": "temp_data.fence.rows_affected" }, 0] },
            "on_reject": "halt"
          }
        }
      },
      {
        "id": "round",
        "name": "Start the rounds that are due",
        "description": "A season round's reset is a ladder write, so it is count's, under count's fence and before the batch: every result folded after it folds into the reset ratings. At most one round a live season is waiting; this starts each whose time has come (raising sigma to its floor, drawing mu toward the season's mean, cancelling the queue paired for the round before) and stamps it applied. The count tick is skipped while nothing finishes, but its marker lives 60 s, so a round starts within a minute or so of its time either way.",
        "function": {
          "name": "db_write",
          "input": {
            "connector": "soma-db",
            "query": { "$sql": "../sql/soma-clock-count-run-round.sql" },
            "params": [
              { "var": "metadata.trigger.scheduled_for" },
              { "var": "metadata.trigger.attempt" }
            ],
            "output": "temp_data.round"
          }
        }
      },
      {
        "id": "invalidate_round",
        "use": "invalidate",
        "with": {
          "namespaces": ["ladder", "season"],
          "when": { ">": [{ "var": "temp_data.round.rows_affected" }, 0] }
        }
      },
      {
        "id": "batch",
        "name": "Read this run's work",
        "function": {
          "name": "db_read",
          "input": {
            "connector": "soma-db",
            "query": { "$sql": "../sql/soma-clock-count-run-batch.sql" },
            "params": [
              { "var": "metadata.vars.count_batch" },
              { "var": "metadata.vars.repair_cap" }
            ],
            "output": "temp_data.rows"
          }
        }
      },
      {
        "id": "mark",
        "name": "Remember that the batch was empty",
        "description": "Written only when the batch had nothing, under the generation read at the top (zero when none exists yet): the next ticks skip until something finishes or 60 s pass. A run that folded writes nothing, so a verdict a fold makes ready is read on the next tick.",
        "condition": { "==": [{ "var": "temp_data.rows.0.body.n" }, 0] },
        "continue_on_error": true,
        "function": {
          "name": "cache_write",
          "input": {
            "connector": "soma-cache",
            "key": "idle:count",
            "value": { "var": "temp_data.generation" },
            "ttl_secs": 60
          }
        }
      }
    ]
  },
  "tasks": [
    {
      "id": "when_priors",
      "condition": { "==": [{ "var": "temp_data.it.kind" }, "fold"] },
      "tasks": [
        {
          "id": "priors",
          "name": "Read the seats' priors",
          "function": {
            "name": "db_read",
            "input": {
              "connector": "soma-db",
              "query": { "$sql": "../sql/soma-clock-count-run-priors.sql" },
              "params": [
                { "var": "temp_data.it.id" },
                { "var": "metadata.vars.ts_beta" },
                { "var": "metadata.vars.ts_tau" },
                { "var": "metadata.vars.ts_draw_probability" }
              ],
              "output": "temp_data.s.match"
            }
          }
        },
        {
          "id": "rate",
          "name": "TrueSkill",
          "function": {
            "name": "tb.rating.trueskill",
            "input": {
              "match": { "var": "temp_data.s.match.0.row" },
              "beta": { "var": "temp_data.s.match.0.beta" },
              "tau": { "var": "temp_data.s.match.0.tau" },
              "draw_probability": { "var": "temp_data.s.match.0.draw_probability" },
              "output": "temp_data.s.post"
            }
          }
        },
        {
          "id": "fold",
          "name": "Mark rated and apply the posteriors",
          "function": {
            "name": "db_write",
            "input": {
              "connector": "soma-db",
              "query": { "$sql": "../sql/soma-clock-count-run-fold.sql" },
              "params": [
                { "var": "metadata.trigger.scheduled_for" },
                { "var": "metadata.trigger.attempt" },
                { "var": "temp_data.it.id" },
                { "var": "temp_data.s.post" }
              ],
              "output": "temp_data.s.folded"
            }
          }
        },
        {
          "id": "invalidate_fold",
          "use": "invalidate",
          "with": {
            "namespaces": ["ladder", "matches"],
            "when": { ">": [{ "var": "temp_data.s.folded.rows_affected" }, 0] }
          }
        },
        {
          "id": "held_why",
          "name": "Why the fold moved nothing",
          "condition": { "!": { ">": [{ "var": "temp_data.s.folded.rows_affected" }, 0] } },
          "function": {
            "name": "db_read",
            "input": {
              "connector": "soma-db",
              "query": { "$sql": "../sql/soma-clock-count-run-held_why.sql" },
              "params": [
                { "var": "metadata.trigger.scheduled_for" },
                { "var": "metadata.trigger.attempt" },
                { "var": "temp_data.it.id" }
              ],
              "output": "temp_data.s.heldwhy"
            }
          }
        },
        {
          "id": "held",
          "name": "Halt only if the fence moved under the fold",
          "description": "A zero-row fold used to halt outright, which read 'the fence moved' -- but a row still finished under a live fence halts the same way, heads the next batch (played_at order) and stops the ladder for ever, undiagnosed. So the fence is asked: gone, halt; held, go on.",
          "function": {
            "name": "filter",
            "input": {
              "condition": {
                "or": [
                  { ">": [{ "var": "temp_data.s.folded.rows_affected" }, 0] },
                  { "var": "temp_data.s.heldwhy.0.mine" }
                ]
              },
              "on_reject": "halt"
            }
          }
        },
        {
          "id": "unfoldable",
          "name": "Log a row the fold cannot count",
          "description": "The only signal for a finished match whose posterior does not cover its seats and ladders (a seat's version missing a ratings row): it is retried every tick, one wasted rate and fold, until it can fold or an admin looks.",
          "condition": {
            "and": [
              { "!": { ">": [{ "var": "temp_data.s.folded.rows_affected" }, 0] } },
              { "var": "temp_data.s.heldwhy.0.unfoldable" }
            ]
          },
          "function": {
            "name": "log",
            "input": {
              "message": "soma-clock-count: a finished match cannot be folded; its posterior does not cover every seat and ladder",
              "level": "warn",
              "fields": { "match_id": { "var": "temp_data.it.id" } }
            }
          }
        },
        {
          "id": "when_folded",
          "description": "The notifications belong to a fold that moved the row; an unfoldable row that the run went on past gets none.",
          "condition": { ">": [{ "var": "temp_data.s.folded.rows_affected" }, 0] },
          "tasks": [
            {
              "id": "notify_result",
              "name": "Tell each seat's owner how it went",
              "continue_on_error": true,
              "function": {
                "name": "db_write",
                "input": {
                  "connector": "soma-db",
                  "query": { "$sql": "../sql/soma-clock-count-run-notify_result.sql" },
                  "params": [{ "var": "temp_data.it.id" }],
                  "output": "temp_data.s.notified_result"
                }
              }
            },
            {
              "id": "notify_rank",
              "name": "Tell each seat's owner a settled rank that moved",
              "continue_on_error": true,
              "function": {
                "name": "db_write",
                "input": {
                  "connector": "soma-db",
                  "query": { "$sql": "../sql/soma-clock-count-run-notify_rank.sql" },
                  "params": [
                    { "var": "temp_data.it.id" },
                    { "var": "metadata.vars.settled_sigma" }
                  ],
                  "output": "temp_data.s.notified_rank"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "when_pass",
      "condition": { "==": [{ "var": "temp_data.it.decision" }, "pass"] },
      "tasks": [
        {
          "id": "pass",
          "name": "Promote and seed",
          "function": {
            "name": "db_write",
            "input": {
              "connector": "soma-db",
              "query": { "$sql": "../sql/soma-clock-count-run-pass.sql" },
              "params": [
                { "var": "metadata.trigger.scheduled_for" },
                { "var": "metadata.trigger.attempt" },
                { "var": "temp_data.it.trial_id" },
                { "var": "temp_data.it.model_id" },
                { "var": "metadata.vars.prior_mu" },
                { "var": "metadata.vars.prior_sigma" },
                { "var": "metadata.vars.sigma_inflation" }
              ],
              "output": "temp_data.s.promoted"
            }
          }
        },
        {
          "id": "invalidate_pass",
          "use": "invalidate",
          "with": {
            "namespaces": ["ladder", "season"],
            "when": { ">": [{ "var": "temp_data.s.promoted.rows_affected" }, 0] }
          }
        },
        {
          "id": "withdraw",
          "name": "Withdraw the predecessor's queue",
          "function": {
            "name": "db_write",
            "input": {
              "connector": "soma-db",
              "query": { "$sql": "../sql/soma-clock-count-run-withdraw.sql" },
              "params": [
                { "var": "temp_data.it.predecessor_id" },
                { "var": "temp_data.it.model_id" }
              ],
              "output": "temp_data.s.withdrawn"
            }
          }
        },
        {
          "id": "invalidate_withdraw",
          "use": "invalidate",
          "with": {
            "namespaces": ["ladder"],
            "when": { ">": [{ "var": "temp_data.s.withdrawn.rows_affected" }, 0] }
          }
        },
        {
          "id": "notify_promoted",
          "name": "Tell the owner it is on the ladder",
          "continue_on_error": true,
          "function": {
            "name": "db_write",
            "input": {
              "connector": "soma-db",
              "query": { "$sql": "../sql/soma-clock-shared-notify.sql" },
              "params": [{ "var": "temp_data.it.model_id" }],
              "output": "temp_data.s.notified_promoted"
            }
          }
        }
      ]
    },
    {
      "id": "when_reject",
      "condition": { "==": [{ "var": "temp_data.it.decision" }, "reject"] },
      "tasks": [
        {
          "id": "reject",
          "name": "Reject, with the reason a competitor reads",
          "function": {
            "name": "db_write",
            "input": {
              "connector": "soma-db",
              "query": { "$sql": "../sql/soma-clock-count-run-reject.sql" },
              "params": [
                { "var": "metadata.trigger.scheduled_for" },
                { "var": "metadata.trigger.attempt" },
                { "var": "temp_data.it.trial_id" },
                { "var": "temp_data.it.model_id" },
                { "var": "temp_data.it.reason" }
              ],
              "output": "temp_data.s.rejected"
            }
          }
        },
        {
          "id": "invalidate_reject",
          "use": "invalidate",
          "with": {
            "namespaces": ["ladder", "season"],
            "when": { ">": [{ "var": "temp_data.s.rejected.rows_affected" }, 0] }
          }
        },
        {
          "id": "notify_rejected",
          "name": "Tell the owner the trial failed",
          "continue_on_error": true,
          "function": {
            "name": "db_write",
            "input": {
              "connector": "soma-db",
              "query": { "$sql": "../sql/soma-clock-shared-notify.sql" },
              "params": [{ "var": "temp_data.it.model_id" }],
              "output": "temp_data.s.notified_rejected"
            }
          }
        }
      ]
    }
  ]
}
