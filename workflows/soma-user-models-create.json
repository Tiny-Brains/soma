{
  "workflow_id": "soma-user-models-create",
  "name": "Create a model",
  "description": "A competitor naming a model. AN ENTRY IS A NAME: unique per owner per game, addressed by its id ever after, and PER SEASON NOTHING (N30/C1) -- naming a model reaches no season, so this route asks no participation or entry-cap question. Every ceiling on a competitor is a per-season rule (entries.max_per_user, max_per_class, in_flight_max, versions_max_per_*, cooldown_s, unique_weights) enforced at SUBMISSION, since a competitor may field different entries in a public season and a cohort's; and this route reaches no host outside the deployment. Write, then diagnose: the insert carries the remaining rules (game exists, session live, name non-empty, within length, not already yours) as predicates so a refusal is a row that was never written, and `why` reads back which one -- an unknown game (404), a name already yours or malformed (409). A model is created empty; POST /v1/submissions is what puts a version under it, in a named season.",
  "tags": ["soma", "user", "models"],
  "tasks": [
    {
      "id": "parse",
      "name": "Parse payload",
      "function": { "name": "parse_json", "input": { "source": "payload", "target": "req" } }
    },
    {
      "id": "declared",
      "use": "refuse",
      "with": {
        "when": { "!": { "var": "data.req.name" } },
        "status": 400,
        "body": {
          "error": "name_required",
          "detail": "name is what you call this model. It has to be unique among your own entries for this game."
        },
        "name": "A name, declared"
      }
    },
    {
      "id": "insert",
      "name": "Create the entry",
      "function": {
        "name": "db_write",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-user-models-create-insert.sql" },
          "params": [
            { "var": "metadata.auth.claims.sub" },
            { "var": "metadata.params.game" },
            { "var": "data.req.name" },
            { "var": "metadata.auth.claims.sid" }
          ],
          "output": "temp_data.written"
        }
      }
    },
    {
      "id": "invalidate",
      "use": "invalidate",
      "with": {
        "namespaces": ["ladder"],
        "when": { ">": [{ "var": "temp_data.written.rows_affected" }, 0] }
      }
    },
    {
      "id": "why",
      "name": "Why nothing was created",
      "condition": { "$use": "none_written", "with": { "slot": "written" } },
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-user-models-create-why.sql" },
          "params": [
            { "var": "metadata.params.game" },
            { "var": "metadata.auth.claims.sub" },
            { "var": "data.req.name" },
            { "var": "metadata.auth.claims.sid" }
          ],
          "output": "temp_data.why"
        }
      }
    },
    {
      "id": "revoked",
      "use": "refuse",
      "with": {
        "when": {
          "and": [
            { "$use": "none_written", "with": { "slot": "written" } },
            { "===": [{ "var": "temp_data.why.0.session_ok" }, false] }
          ]
        },
        "status": 401,
        "body": { "error": "session_revoked" },
        "name": "A live session first",
        "description": "The write joined live_sessions and wrote nothing, and the why says the session is gone: 401, before any reason the same absence could be mistaken for. `===` false, so a why that returned no row (an unknown game) answers its own refusal instead."
      }
    },
    {
      "id": "unknown",
      "use": "refuse",
      "with": {
        "when": {
          "and": [
            { "$use": "none_written", "with": { "slot": "written" } },
            { "!": { "var": "temp_data.why.0.body.found" } }
          ]
        },
        "status": 404,
        "body": { "error": "unknown_game" },
        "name": "No such game"
      }
    },
    {
      "id": "refused",
      "use": "refuse",
      "with": {
        "when": { "$use": "none_written", "with": { "slot": "written" } },
        "status": 409,
        "body": {
          "error": {
            "if": [
              { "!!": { "var": "temp_data.why.0.body.name_taken" } },
              "model_name_taken",
              "name_invalid"
            ]
          },
          "detail": { "var": "temp_data.why.0.body" }
        },
        "name": "Refused"
      }
    },
    {
      "id": "fetch",
      "name": "Read the entry back",
      "description": "Keyed on the name, which models_owner_game_name_uniq makes a key: db_write answers only rows_affected, so the created row is read back, and the read-back needs a unique predicate.",
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-user-models-create-fetch.sql" },
          "params": [
            { "var": "metadata.auth.claims.sub" },
            { "var": "metadata.params.game" },
            { "var": "data.req.name" },
            { "var": "metadata.auth.claims.sid" }
          ],
          "output": "temp_data.rows"
        }
      }
    },
    {
      "id": "deny",
      "use": "deny-revoked",
      "with": { "row": "temp_data.rows.0.body" }
    },
    {
      "id": "respond",
      "name": "Respond",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            { "path": "data.body", "logic": { "var": "temp_data.rows.0.body" } },
            { "path": "data._orion.response", "logic": { "$from": "constants.created" } }
          ]
        }
      }
    }
  ]
}
