{
  "workflow_id": "soma-admin-seasons-create",
  "name": "Create a season",
  "description": "Admin only. ONE STATEMENT creates the season -- its NAME and the slug season_slug() derives from it, both fixed for ever, number last+1 as an internal ordinal, the engine pinned from games.active_engine_digest, the window, the whole rules document, and four settings that are not rules: `visibility` (public|private), `entry` (open|restricted; private forces restricted), `fleet` (which runners play it) and `providers` (which identity providers may enter). SEASONS OVERLAP (N30): a game may run any number of live seasons at once, so there is no 'a season is still live' or 'inside season_gap_days' refusal any more. Refusals, told apart by `why`: a name that gives no usable slug, a slug another season holds, or no engine declared. The season opens with NO MAPS AND NO BASELINES: both are uploaded to it afterwards, land out of play, and are put in play by hand -- and until a baseline is enabled no trial can be seated, so every candidate waits. A season's baselines are its own uploads, never carried forward from the previous season, and a name used again is the same baseline account with a new version. SEASON ADMINS MAY BE NAMED (`admins`, handles): checked before the create (400 admins_invalid, 422 admins_unknown naming each unknown handle) and assigned after it, as soma-admin-season-admins-add assigns one. A malformed `providers` is 400 providers_invalid. PARTICIPANTS ARE NOT SET HERE (N30): a cohort is season_participants + `entry = 'restricted'`, added on the season admin page after creation, so a class can add a late student once the season is open (rules freeze at open). WEIGHT CLASSES ARE THE SEASON'S: absent from the body it inherits the previous season's table rather than a constant.",
  "tags": ["soma", "admin", "seasons"],
  "tasks": [
    {
      "id": "parse",
      "name": "Parse payload",
      "function": { "name": "parse_json", "input": { "source": "payload", "target": "req" } }
    },
    {
      "id": "admin",
      "use": "admin-only"
    },
    {
      "id": "named",
      "use": "refuse",
      "with": {
        "when": { "!": { "var": "data.req.name" } },
        "status": 400,
        "body": {
          "error": "name_required",
          "detail": "A season is named when it is created -- \"Summer 2026\" -- and its slug, summer-2026, is how every link addresses it. Neither can be changed later."
        },
        "name": "A name, declared"
      }
    },
    {
      "id": "dates",
      "use": "refuse",
      "with": {
        "when": {
          "or": [
            { "!": { "var": "data.req.submissions_open_at" } },
            { "!": { "var": "data.req.submissions_close_at" } }
          ]
        },
        "status": 400,
        "body": {
          "error": "dates_required",
          "detail": "submissions_open_at and submissions_close_at are required, as ISO-8601 timestamps."
        },
        "name": "Both dates, declared"
      }
    },
    {
      "id": "visibility",
      "use": "refuse",
      "with": {
        "when": {
          "and": [
            { "!!": { "var": "data.req.visibility" } },
            {
              "!": {
                "or": [
                  { "===": [{ "var": "data.req.visibility" }, "public"] },
                  { "===": [{ "var": "data.req.visibility" }, "private"] }
                ]
              }
            }
          ]
        },
        "status": 400,
        "body": {
          "error": "visibility_invalid",
          "detail": "visibility is \"public\" or \"private\". A private season is watchable only by its participants, its season admins and platform admins."
        },
        "name": "Visibility is public or private"
      }
    },
    {
      "id": "entry",
      "use": "refuse",
      "with": {
        "when": {
          "and": [
            { "!!": { "var": "data.req.entry" } },
            {
              "!": {
                "or": [
                  { "===": [{ "var": "data.req.entry" }, "open"] },
                  { "===": [{ "var": "data.req.entry" }, "restricted"] }
                ]
              }
            }
          ]
        },
        "status": 400,
        "body": {
          "error": "entry_invalid",
          "detail": "entry is \"open\" or \"restricted\". A private season is always restricted."
        },
        "name": "Entry is open or restricted"
      }
    },
    {
      "id": "fleet",
      "use": "refuse",
      "with": {
        "when": {
          "and": [
            { "!!": { "var": "data.req.fleet" } },
            {
              "!": {
                "and": [
                  {
                    "or": [
                      { "===": [{ "var": "data.req.fleet.matches" }, "own"] },
                      { "===": [{ "var": "data.req.fleet.matches" }, "platform"] },
                      { "===": [{ "var": "data.req.fleet.matches" }, "both"] }
                    ]
                  },
                  {
                    "or": [
                      { "===": [{ "var": "data.req.fleet.admissions" }, "own"] },
                      { "===": [{ "var": "data.req.fleet.admissions" }, "platform"] },
                      { "===": [{ "var": "data.req.fleet.admissions" }, "both"] }
                    ]
                  }
                ]
              }
            }
          ]
        },
        "status": 400,
        "body": {
          "error": "fleet_invalid",
          "detail": "fleet has matches and admissions, each \"own\", \"platform\" or \"both\"."
        },
        "name": "Fleet policy is well formed"
      }
    },
    {
      "id": "check",
      "name": "Check the providers and admins lists",
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-admin-seasons-create-check.sql" },
          "params": [{ "var": "data.req" }],
          "output": "temp_data.check"
        }
      }
    },
    {
      "id": "providers",
      "use": "refuse",
      "with": {
        "when": { "!": { "var": "temp_data.check.0.body.providers_ok" } },
        "status": 400,
        "body": {
          "error": "providers_invalid",
          "detail": "providers is null (any provider) or an array of provider slugs."
        },
        "name": "Providers are a list of slugs"
      }
    },
    {
      "id": "admins_shape",
      "use": "refuse",
      "with": {
        "when": { "!": { "var": "temp_data.check.0.body.admins_ok" } },
        "status": 400,
        "body": { "error": "admins_invalid", "detail": "admins is an array of platform handles." },
        "name": "Admins are a list of handles"
      }
    },
    {
      "id": "admins_known",
      "use": "refuse",
      "with": {
        "when": { ">": [{ "length": { "var": "temp_data.check.0.body.unknown" } }, 0] },
        "status": 422,
        "body": {
          "error": "admins_unknown",
          "detail": "No account has these handles; a baseline cannot be a season admin.",
          "handles": { "var": "temp_data.check.0.body.unknown" }
        },
        "name": "Every admin is an account"
      }
    },
    {
      "id": "rules",
      "name": "Take the rules as given",
      "function": {
        "name": "map",
        "input": {
          "mappings": [{ "path": "temp_data.rules", "logic": { "var": "data.req.rules" } }]
        }
      }
    },
    {
      "id": "create",
      "name": "Create the season",
      "function": {
        "name": "db_write",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-admin-seasons-create-create.sql" },
          "params": [
            { "var": "metadata.params.game" },
            { "var": "data.req.submissions_open_at" },
            { "var": "data.req.submissions_close_at" },
            { "var": "temp_data.rules" },
            { "var": "data.req.weight_classes" },
            { "var": "data.req.name" },
            { "var": "metadata.auth.claims.sub" },
            { "var": "data.req.visibility" },
            { "var": "data.req.entry" },
            { "var": "data.req.fleet" },
            { "var": "data.req.providers" }
          ],
          "output": "temp_data.created"
        }
      }
    },
    {
      "id": "invalidate",
      "use": "invalidate",
      "with": {
        "namespaces": ["season", "ladder"],
        "when": { ">": [{ "var": "temp_data.created.rows_affected" }, 0] }
      }
    },
    {
      "id": "admins",
      "name": "Assign the season admins named at create",
      "description": "Only after a create that wrote, and only when the body named admins: the check above refused an unknown handle, so each is an account.",
      "condition": {
        "and": [
          { ">": [{ "var": "temp_data.created.rows_affected" }, 0] },
          { "!!": { "var": "data.req.admins" } }
        ]
      },
      "function": {
        "name": "db_write",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-admin-seasons-create-admins.sql" },
          "params": [
            { "var": "metadata.params.game" },
            { "var": "data.req.name" },
            { "var": "data.req.admins" },
            { "var": "metadata.auth.claims.sub" }
          ],
          "output": "temp_data.admins"
        }
      }
    },
    {
      "id": "why",
      "name": "Why nothing was created",
      "condition": { "$use": "none_written", "with": { "slot": "created" } },
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-admin-seasons-create-why.sql" },
          "params": [{ "var": "metadata.params.game" }, { "var": "data.req.name" }],
          "output": "temp_data.why"
        }
      }
    },
    {
      "id": "unknown",
      "use": "refuse",
      "with": {
        "when": {
          "and": [
            { "$use": "none_written", "with": { "slot": "created" } },
            { "!": { "var": "temp_data.why.0.body" } }
          ]
        },
        "status": 404,
        "body": { "error": "unknown_game" },
        "name": "No such game"
      }
    },
    {
      "id": "unusable",
      "use": "refuse",
      "with": {
        "when": {
          "and": [
            { "$use": "none_written", "with": { "slot": "created" } },
            { "===": [{ "var": "temp_data.why.0.body.name_usable" }, false] }
          ]
        },
        "status": 400,
        "body": {
          "error": "season_name_unusable",
          "detail": "A name is 1 to 48 characters and must leave a slug -- letters and digits, joined by hyphens -- that is not current, live, latest or new.",
          "slug": { "var": "temp_data.why.0.body.slug" }
        },
        "name": "A name that makes a slug"
      }
    },
    {
      "id": "refused",
      "use": "refuse",
      "with": {
        "when": { "$use": "none_written", "with": { "slot": "created" } },
        "status": 409,
        "body": {
          "error": {
            "if": [
              { "!!": { "var": "temp_data.why.0.body.taken_by" } },
              "season_slug_taken",
              "no_engine"
            ]
          },
          "detail": { "var": "temp_data.why.0.body" }
        },
        "name": "Refused"
      }
    },
    {
      "id": "read",
      "name": "Read the season back",
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": "SELECT season_json(s) AS body FROM games g, current_season(g.id, season_slug(btrim(($2)::text))) s WHERE g.slug = ($1)::text",
          "params": [{ "var": "metadata.params.game" }, { "var": "data.req.name" }],
          "output": "temp_data.rows"
        }
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            { "path": "data.body", "logic": { "var": "temp_data.rows.0.body" } },
            { "path": "data._orion.response", "logic": { "$from": "constants.created" } }
          ]
        }
      }
    }
  ]
}
