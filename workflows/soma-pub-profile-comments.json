{
  "workflow_id": "soma-pub-profile-comments",
  "name": "A competitor's comments",
  "description": "AN AUTHOR'S LIVE COMMENTS, newest first, twenty a page, keyset on (created_at, id) down comments_author_idx. Each is comment_json() plus its host (`match` or `model`), the host's id, the model's name on a model thread, and `link`, the site path that opens it at the comment. Held, removed and deleted comments are not here: the profile is public. Unknown handle: 404.",
  "tags": ["soma", "pub", "profile"],
  "tasks": [
    {
      "id": "query",
      "name": "Query",
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-pub-profile-comments-query.sql" },
          "params": [{ "var": "metadata.params.username" }, { "var": "metadata.query.cursor" }],
          "output": "temp_data.rows"
        }
      }
    },
    {
      "id": "unknown",
      "use": "refuse",
      "with": {
        "when": { "!": { "var": "temp_data.rows.0.body" } },
        "status": 404,
        "body": { "error": "unknown_user" },
        "name": "Reject an unknown handle"
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            { "path": "data.body", "logic": { "var": "temp_data.rows.0.body" } },
            { "path": "data._orion.response", "logic": { "$from": "constants.ok" } }
          ]
        }
      }
    }
  ]
}
