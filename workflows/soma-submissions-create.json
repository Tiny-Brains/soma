{
  "workflow_id": "soma-submissions-create",
  "name": "Enter a version",
  "description": "Recording a submission as a testing version. A submission is two hashes and two uploads -- there is no release and no repository, and `version` is a counter this statement assigns rather than a label the competitor types. Two statements, not one: db_write returns only rows_affected, so the row is read back, and both statements join live_sessions -- a revoked session must neither write nor read, and the read-back alone deciding 201 would fail open. The insert carries the open season's rules as PREDICATES, so a refusal is a row that was never written rather than a check that could be raced; zero rows then sends `why` to read the state back and `refused` answers 409 with one word. The duplicate refusal deliberately does not name the version it collided with: unique_weights excludes the caller, so the row it matched is always another competitor's, and naming or dating it would report one competitor's submission to another.",
  "tags": ["pkg:soma"],
  "tasks": [
    {
      "id": "parse",
      "name": "Parse payload",
      "function": { "name": "parse_json", "input": { "source": "payload", "target": "req" } }
    },
    {
      "id": "declared",
      "use": "refuse",
      "with": {
        "when": {
          "or": [
            {
              "or": [
                { "!": { "var": "data.req.weights_hash" } },
                { "!": { "starts_with": [{ "var": "data.req.weights_hash" }, "sha256:"] } },
                { "!=": [{ "length": [{ "var": "data.req.weights_hash" }] }, 71] }
              ]
            },
            {
              "or": [
                { "!": { "var": "data.req.manifest_hash" } },
                { "!": { "starts_with": [{ "var": "data.req.manifest_hash" }, "sha256:"] } },
                { "!=": [{ "length": [{ "var": "data.req.manifest_hash" }] }, 71] }
              ]
            }
          ]
        },
        "status": 400,
        "body": {
          "error": "hashes_required",
          "detail": "weights_hash and manifest_hash are required, each as sha256:<64 hex>. Run `sha256sum model.onnx manifest.json` on the two files you are about to upload."
        },
        "name": "Both hashes, declared and well formed",
        "description": "`sha256:` and 71 characters, which is the shape and not the alphabet -- datalogic has no regex operator. The alphabet does not have to be checked here: the object key is a GENERATED column derived from the version id, so a hash is never a path."
      }
    },
    {
      "id": "insert",
      "name": "Insert the testing row",
      "function": {
        "name": "db_write",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-submissions-create-insert.sql" },
          "params": [
            { "var": "metadata.auth.claims.sub" },
            { "var": "data.req.game" },
            { "var": "data.req.model" },
            { "var": "metadata.auth.claims.sid" },
            { "var": "data.req.weights_hash" },
            { "var": "data.req.manifest_hash" }
          ],
          "output": "temp_data.insert"
        }
      }
    },
    {
      "id": "why",
      "name": "Why nothing was inserted",
      "condition": { "!": { ">": [{ "var": "temp_data.insert.rows_affected" }, 0] } },
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-submissions-create-why.sql" },
          "params": [
            { "var": "data.req.game" },
            { "var": "metadata.auth.claims.sub" },
            { "var": "data.req.weights_hash" },
            { "var": "data.req.model" },
            { "var": "data.req.manifest_hash" }
          ],
          "output": "temp_data.why"
        }
      }
    },
    {
      "id": "unknown_model",
      "use": "refuse",
      "with": {
        "when": {
          "and": [
            { "!": { ">": [{ "var": "temp_data.insert.rows_affected" }, 0] } },
            { "!": { "var": "temp_data.why.0.body.model" } },
            { "!!": { "var": "temp_data.why.0.body" } }
          ]
        },
        "status": 404,
        "body": { "error": "unknown_model", "detail": { "var": "data.req.model" } },
        "name": "No such model",
        "description": "A submission names a model the caller does not own, or does not have: 404 and not 409, because nothing about the season refused it. Entries are created explicitly -- a repository with no entry behind it is not silently adopted, or a typo in a repo path would quietly start a second lineage with its own version numbers."
      }
    },
    {
      "id": "refused",
      "use": "refuse",
      "with": {
        "when": {
          "and": [
            { "!": { ">": [{ "var": "temp_data.insert.rows_affected" }, 0] } },
            { "!!": { "var": "temp_data.why.0.body.model" } },
            {
              "or": [
                { "!=": [{ "var": "temp_data.why.0.body.state" }, "open"] },
                { "!": { "var": "temp_data.why.0.body.participant" } },
                { "!!": { "var": "temp_data.why.0.body.model.retired" } },
                {
                  "and": [
                    { "!!": { "var": "temp_data.why.0.body.entry_in_flight" } },
                    { "!": { "var": "temp_data.why.0.body.same_submission" } }
                  ]
                },
                { "!": { "var": "temp_data.why.0.body.in_flight_ok" } },
                { "!": { "var": "temp_data.why.0.body.versions_ok" } },
                {
                  "and": [
                    { "!!": { "var": "temp_data.why.0.body.cooldown_until" } },
                    { ">": [{ "var": "temp_data.why.0.body.cooldown_until" }, { "now": [] }] }
                  ]
                },
                { "!": { "var": "temp_data.why.0.body.unique_weights" } }
              ]
            }
          ]
        },
        "status": 409,
        "body": {
          "error": {
            "if": [
              { "!=": [{ "var": "temp_data.why.0.body.state" }, "open"] },
              "season_not_open",
              { "!": { "var": "temp_data.why.0.body.participant" } },
              "not_a_participant",
              { "!!": { "var": "temp_data.why.0.body.model.retired" } },
              "model_retired",
              {
                "and": [
                  { "!!": { "var": "temp_data.why.0.body.entry_in_flight" } },
                  { "!": { "var": "temp_data.why.0.body.same_submission" } }
                ]
              },
              "version_in_flight",
              { "!": { "var": "temp_data.why.0.body.in_flight_ok" } },
              "too_many_in_flight",
              { "!": { "var": "temp_data.why.0.body.versions_ok" } },
              "too_many_versions",
              {
                "and": [
                  { "!!": { "var": "temp_data.why.0.body.cooldown_until" } },
                  { ">": [{ "var": "temp_data.why.0.body.cooldown_until" }, { "now": [] }] }
                ]
              },
              "cooling_down",
              "weights_already_entered"
            ]
          },
          "detail": { "var": "temp_data.why.0.body" }
        },
        "name": "Refused by the season",
        "description": "`entry_in_flight` refuses only a DIFFERENT submission. Re-POSTing the SAME two hashes for the row already in flight falls through to fetch + sign and answers with fresh upload URLs, which is what the response has always promised and never did: the presigns expire in thirty minutes, and before this a competitor who lost them had a version they could not upload to and could not replace."
      }
    },
    {
      "id": "fetch",
      "name": "Read the row back",
      "description": "Keyed on the entry id and the declared weights hash rather than a release tag: model_versions_one_in_flight_uniq makes at most one 'testing' row per entry, so the pair is unique. It is also the read-back the 401 guard rides -- a revoked session must neither write nor read, and the read-back alone deciding 201 would fail open.",
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-submissions-create-fetch.sql" },
          "params": [
            { "var": "metadata.auth.claims.sub" },
            { "var": "data.req.game" },
            { "var": "data.req.model" },
            { "var": "metadata.auth.claims.sid" },
            { "var": "data.req.weights_hash" }
          ],
          "output": "temp_data.rows"
        }
      }
    },
    {
      "id": "sign",
      "name": "Sign both uploads",
      "description": "Both presigns are asked the same question -- did the INSERT create a version -- so the group carries the condition once and the two steps inside carry none. Neither writes what it reads, so one evaluation is the whole answer.",
      "condition": { "!!": { "var": "temp_data.rows.0.body.version_id" } },
      "tasks": [
        {
          "id": "sign_weights",
          "name": "A one-shot PUT for the ONNX graph",
          "function": {
            "name": "storage_presign",
            "input": {
              "connector": "soma-models",
              "method": "PUT",
              "key": {
                "cat": ["models/", { "var": "temp_data.rows.0.body.version_id" }, "/", "model.onnx"]
              },
              "expires_in": "30m",
              "output": "temp_data.put_weights"
            }
          }
        },
        {
          "id": "sign_manifest",
          "name": "A one-shot PUT for the manifest",
          "function": {
            "name": "storage_presign",
            "input": {
              "connector": "soma-models",
              "method": "PUT",
              "key": {
                "cat": [
                  "models/",
                  { "var": "temp_data.rows.0.body.version_id" },
                  "/",
                  "manifest.json"
                ]
              },
              "expires_in": "30m",
              "output": "temp_data.put_manifest"
            }
          }
        }
      ]
    },
    {
      "id": "deny",
      "use": "deny-revoked",
      "with": { "row": "temp_data.rows.0.body" }
    },
    {
      "id": "respond",
      "name": "Respond",
      "description": "201 when the insert created the row, 200 when it did not -- which is the re-mint: the same two hashes for the version already in flight answer with fresh presigned URLs and nothing was created.",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            { "path": "data.body", "logic": { "var": "temp_data.rows.0.body" } },
            {
              "path": "data.body.upload",
              "logic": {
                "if": [
                  { "!!": { "var": "temp_data.rows.0.body.version_id" } },
                  {
                    "model_onnx": { "var": "temp_data.put_weights" },
                    "manifest_json": { "var": "temp_data.put_manifest" },
                    "expires_in": "30m",
                    "note": "PUT your two files to these URLs. They are one-shot and expire in 30 minutes; POST this submission again with the same two hashes to get fresh ones."
                  },
                  null
                ]
              }
            },
            {
              "path": "data._orion.response",
              "logic": {
                "if": [
                  { ">": [{ "var": "temp_data.insert.rows_affected" }, 0] },
                  { "$from": "constants.created" },
                  { "$from": "constants.ok" }
                ]
              }
            }
          ]
        }
      }
    }
  ]
}
