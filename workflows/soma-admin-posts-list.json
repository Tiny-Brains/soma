{
  "workflow_id": "soma-admin-posts-list",
  "name": "Posts",
  "description": "Every post, drafts and published, newest edit first: title, slug, author, updated, published. No text -- the list is a table, and a row opens GET /v1/admin/posts/{id}.",
  "tags": ["soma", "admin", "community"],
  "tasks": [
    {
      "id": "admin",
      "use": "admin-only"
    },
    {
      "id": "query",
      "name": "Query",
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-admin-posts-list-query.sql" },
          "params": [],
          "output": "temp_data.rows"
        }
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            { "path": "data.body", "logic": { "var": "temp_data.rows.0.body" } },
            { "path": "data._orion.response", "logic": { "$from": "constants.ok" } }
          ]
        }
      }
    }
  ]
}
