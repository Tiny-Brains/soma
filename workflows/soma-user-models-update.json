{
  "workflow_id": "soma-user-models-update",
  "name": "Rename or retire a model",
  "description": "The two things about a model a competitor may change. A name is a label and may be edited; `retired` is how a competitor puts a model down and is reversible, because it withdraws nothing that has already been played -- every version keeps its ratings and its seats, so retiring is not a way to restart a version series. A retired model takes no new submissions and frees its slot under entries.max_per_user. THE ENTRY'S ID IS THE KEY AND IS NOT A FIELD, which is what makes the name safe to edit: a model whose key could change would be a different entry wearing this one's ratings, and addressing by id removes that problem rather than guarding it. Each field is coalesced against the stored value, which is what PATCH means. Ownership is in the statement, not beside it: the UPDATE names the caller's own row, so someone else's model is simply not found.",
  "tags": ["soma", "user", "models"],
  "tasks": [
    {
      "id": "parse",
      "name": "Parse payload",
      "function": { "name": "parse_json", "input": { "source": "payload", "target": "req" } }
    },
    {
      "id": "edit",
      "name": "Rename, retire or revive",
      "function": {
        "name": "db_write",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-user-models-update-edit.sql" },
          "params": [
            { "var": "metadata.params.id" },
            { "var": "metadata.auth.claims.sub" },
            { "var": "metadata.auth.claims.sid" },
            { "var": "data.req.name" },
            { "var": "data.req.retired" }
          ],
          "output": "temp_data.written"
        }
      }
    },
    {
      "id": "invalidate",
      "use": "invalidate",
      "with": {
        "namespaces": ["ladder", "matches", "community"],
        "when": { ">": [{ "var": "temp_data.written.rows_affected" }, 0] }
      }
    },
    {
      "id": "why",
      "name": "Why nothing changed",
      "condition": { "$use": "none_written", "with": { "slot": "written" } },
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-user-models-update-why.sql" },
          "params": [
            { "var": "metadata.params.id" },
            { "var": "data.req.name" },
            { "var": "metadata.auth.claims.sub" },
            { "var": "metadata.auth.claims.sid" }
          ],
          "output": "temp_data.why"
        }
      }
    },
    {
      "id": "revoked",
      "use": "refuse",
      "with": {
        "when": {
          "and": [
            { "$use": "none_written", "with": { "slot": "written" } },
            { "===": [{ "var": "temp_data.why.0.session_ok" }, false] }
          ]
        },
        "status": 401,
        "body": { "error": "session_revoked" },
        "name": "A live session first",
        "description": "The write joined live_sessions and wrote nothing, and the why says the session is gone: 401, before any reason the same absence could be mistaken for. `===` false, so a why that returned no row (an unknown game) answers its own refusal instead."
      }
    },
    {
      "id": "unknown",
      "use": "refuse",
      "with": {
        "when": {
          "and": [
            { "$use": "none_written", "with": { "slot": "written" } },
            { "!": { "var": "temp_data.why.0.body" } }
          ]
        },
        "status": 404,
        "body": { "error": "unknown_model" },
        "name": "No such model of yours"
      }
    },
    {
      "id": "refused",
      "use": "refuse",
      "with": {
        "when": { "$use": "none_written", "with": { "slot": "written" } },
        "status": 409,
        "body": {
          "error": {
            "if": [
              { "!!": { "var": "temp_data.why.0.body.name_taken" } },
              "model_name_taken",
              "name_invalid"
            ]
          },
          "detail": { "var": "temp_data.why.0.body" }
        },
        "name": "Refused"
      }
    },
    {
      "id": "read",
      "name": "Read it back",
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-user-models-update-read.sql" },
          "params": [{ "var": "metadata.params.id" }, { "var": "metadata.auth.claims.sub" }],
          "output": "temp_data.rows"
        }
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            { "path": "data.body", "logic": { "var": "temp_data.rows.0.body" } },
            { "path": "data._orion.response", "logic": { "$from": "constants.ok" } }
          ]
        }
      }
    }
  ]
}
