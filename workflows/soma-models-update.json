{
  "workflow_id": "soma-models-update",
  "name": "Rename or retire a model",
  "description": "The two things about a model a competitor may change. A name is a label and may be edited; `retired` is how a competitor puts a model down and is reversible, because it withdraws nothing that has already been played -- every version keeps its ratings and its seats, so retiring is not a way to restart a version series. A retired model takes no new submissions and frees its slot under entries.max_per_user. THE ENTRY'S ID IS THE KEY AND IS NOT A FIELD, which is what makes the name safe to edit: it used to be the GitHub repository, immutable precisely because a model that could move repositories would be a different entry wearing this one's ratings. Addressing by id removes that problem rather than guarding it. Each field is coalesced against the stored value, which is what PATCH means. Ownership is in the statement, not beside it: the UPDATE names the caller's own row, so someone else's model is simply not found.",
  "tags": ["pkg:soma"],
  "tasks": [
    {
      "id": "parse",
      "name": "Parse payload",
      "function": { "name": "parse_json", "input": { "source": "payload", "target": "req" } }
    },
    {
      "id": "edit",
      "name": "Rename, retire or revive",
      "function": {
        "name": "db_write",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-models-update-edit.sql" },
          "params": [
            { "var": "metadata.params.id" },
            { "var": "metadata.auth.claims.sub" },
            { "var": "metadata.auth.claims.sid" },
            { "var": "data.req.name" },
            { "var": "data.req.retired" }
          ],
          "output": "temp_data.written"
        }
      }
    },
    {
      "id": "why",
      "name": "Why nothing changed",
      "condition": { "!": { ">": [{ "var": "temp_data.written.rows_affected" }, 0] } },
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-models-update-why.sql" },
          "params": [
            { "var": "metadata.params.id" },
            { "var": "data.req.name" },
            { "var": "metadata.auth.claims.sub" }
          ],
          "output": "temp_data.why"
        }
      }
    },
    {
      "id": "unknown",
      "use": "refuse",
      "with": {
        "when": {
          "and": [
            { "!": { ">": [{ "var": "temp_data.written.rows_affected" }, 0] } },
            { "!": { "var": "temp_data.why.0.body" } }
          ]
        },
        "status": 404,
        "body": { "error": "unknown_model" },
        "name": "No such model of yours"
      }
    },
    {
      "id": "refused",
      "use": "refuse",
      "with": {
        "when": { "!": { ">": [{ "var": "temp_data.written.rows_affected" }, 0] } },
        "status": 409,
        "body": {
          "error": {
            "if": [
              { "!!": { "var": "temp_data.why.0.body.name_taken" } },
              "model_name_taken",
              "name_invalid"
            ]
          },
          "detail": { "var": "temp_data.why.0.body" }
        },
        "name": "Refused"
      }
    },
    {
      "id": "read",
      "name": "Read it back",
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-models-update-read.sql" },
          "params": [{ "var": "metadata.params.id" }, { "var": "metadata.auth.claims.sub" }],
          "output": "temp_data.rows"
        }
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            { "path": "data.body", "logic": { "var": "temp_data.rows.0.body" } },
            { "path": "data._orion.response", "logic": { "$from": "constants.ok" } }
          ]
        }
      }
    }
  ]
}
