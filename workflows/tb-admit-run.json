{
  "workflow_id": "tb-admit-run",
  "name": "Clock: admit",
  "description": "What moves a submission off `testing`, in two walks with an admitting runner between them, because Soma runs no model. PREPARE reads the manifest the competitor uploaded and checks it against the hash they declared, checks the artifact is in the bucket, rebuilds the registration field by field, and queues one `admissions` row. A runner whose role is `admit` claims it through the gate, registers the model on its own node by reference and digest -- the node fetches and re-hashes the object, so a row that lies fails admission -- lets Orion admit it, plays it over the game's reference observations, deletes it, and reports what it found. DECIDE reads that report through admission_facts(), measures S' from this clock's own HEAD and the runner's bytes, picks the season's class, applies the platform's policy to the stats and writes one verdict. A baseline lands `disabled` rather than `verified`. The branch that matters is on `fault`: a competitor's mistake rejects the version; a report that decided nothing goes back to the queue with its attempt spent, so a submission that fails the same way on every runner expires TIMED_OUT; and a fault of this clock's releases the item untouched. The claim is the fence. Every verdict, and every expiry this run stamped with its token, is then told to the owner by a keyed statement that may fail without failing the walk.",
  "tags": ["pkg:soma"],
  "condition": true,
  "loop": { "counter": "i", "max": 64 },
  "tasks": [
    {
      "id": "when_token",
      "condition": { "==": [{ "var": "temp_data.i" }, 0] },
      "tasks": [
        {
          "id": "token",
          "name": "This run's claim token",
          "function": {
            "name": "map",
            "input": {
              "mappings": [{ "path": "temp_data.token", "logic": { "random": ["uuid"] } }]
            }
          }
        },
        {
          "id": "expire",
          "name": "Reject what has run out of attempts",
          "function": {
            "name": "db_write",
            "input": {
              "connector": "soma-db",
              "query": { "$sql": "../sql/tb-admit-run-expire.sql" },
              "params": [
                { "var": "metadata.vars.admit_attempts_max" },
                { "var": "metadata.vars.admit_timeout_s" },
                { "var": "temp_data.token" }
              ],
              "output": "temp_data.expired"
            }
          }
        },
        {
          "id": "claim",
          "name": "Claim up to admit_batch submissions",
          "function": {
            "name": "db_write",
            "input": {
              "connector": "soma-db",
              "query": { "$sql": "../sql/tb-admit-run-claim.sql" },
              "params": [
                { "var": "temp_data.token" },
                { "var": "metadata.vars.admit_batch" },
                { "var": "metadata.vars.admit_timeout_s" }
              ],
              "output": "temp_data.claimed"
            }
          }
        },
        {
          "id": "batch",
          "name": "Read what this run claimed",
          "function": {
            "name": "db_read",
            "input": {
              "connector": "soma-db",
              "query": { "$sql": "../sql/tb-admit-run-batch.sql" },
              "params": [
                { "var": "temp_data.token" },
                { "var": "metadata.vars.opset_min" },
                { "var": "metadata.vars.opset_max" },
                { "var": "metadata.vars.op_allowlist" },
                { "var": "metadata.vars.model_prefix" }
              ],
              "output": "temp_data.batch"
            }
          }
        }
      ]
    },
    {
      "id": "notify_expired",
      "name": "Tell the owners what just timed out",
      "condition": {
        "and": [
          { "==": [{ "var": "temp_data.i" }, 0] },
          { ">": [{ "var": "temp_data.expired.rows_affected" }, 0] }
        ]
      },
      "continue_on_error": true,
      "function": {
        "name": "db_write",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/tb-admit-run-notify_expired.sql" },
          "params": [{ "var": "temp_data.token" }],
          "output": "temp_data.notified_expired"
        }
      }
    },
    {
      "id": "more",
      "name": "Stop when the work runs out",
      "function": {
        "name": "filter",
        "input": {
          "condition": { "<": [{ "var": "temp_data.i" }, { "var": "temp_data.batch.0.body.n" }] },
          "on_reject": "halt"
        }
      }
    },
    {
      "id": "item",
      "name": "Take submission i, and clear the last one",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            {
              "path": "temp_data.it",
              "logic": {
                "val": ["temp_data", "batch", 0, "body", "items", { "val": ["temp_data", "i"] }]
              }
            },
            { "path": "temp_data.head", "logic": false },
            { "path": "temp_data.man", "logic": false },
            { "path": "temp_data.mtext", "logic": false },
            { "path": "temp_data.signed", "logic": false },
            { "path": "temp_data.manok", "logic": false },
            { "path": "temp_data.reg", "logic": false },
            { "path": "temp_data.abytes", "logic": false },
            { "path": "temp_data.clsrow", "logic": false },
            { "path": "temp_data.cls", "logic": false },
            { "path": "temp_data.ops", "logic": false },
            { "path": "temp_data.reason", "logic": false },
            { "path": "temp_data.again", "logic": false },
            {
              "path": "temp_data.retry",
              "logic": {
                "if": [
                  { "var": "temp_data.it.job" },
                  false,
                  { "!": { "var": "temp_data.it.budget_ops" } },
                  "MANIFEST_INCOMPLETE",
                  { "!": { "var": "temp_data.it.observations_n" } },
                  "MANIFEST_INCOMPLETE",
                  { "!": { "var": "temp_data.it.artifact_key" } },
                  "MANIFEST_INCOMPLETE",
                  false
                ]
              }
            }
          ]
        }
      }
    },
    {
      "id": "head",
      "name": "Is the artifact in the bucket?",
      "condition": {
        "and": [{ "!": { "var": "temp_data.it.job" } }, { "!": { "var": "temp_data.retry" } }]
      },
      "continue_on_error": true,
      "function": {
        "name": "storage_head",
        "input": {
          "connector": "soma-models-internal",
          "key": { "var": "temp_data.it.artifact_key" },
          "output": "temp_data.head"
        }
      }
    },
    {
      "id": "sign",
      "name": "Sign a GET for the manifest",
      "condition": {
        "and": [
          { "!": { "var": "temp_data.it.job" } },
          { "!": { "var": "temp_data.retry" } },
          { "var": "temp_data.head.exists" }
        ]
      },
      "continue_on_error": true,
      "function": {
        "name": "storage_presign",
        "input": {
          "connector": "soma-models-internal",
          "method": "GET",
          "key": { "var": "temp_data.it.manifest_key" },
          "expires_in": "5m",
          "output": "temp_data.signed"
        }
      }
    },
    {
      "id": "fetch_text",
      "name": "The manifest, as the bytes that were uploaded",
      "condition": { "!!": { "var": "temp_data.signed" } },
      "continue_on_error": true,
      "function": {
        "name": "http_call",
        "input": {
          "connector": "soma-models-http",
          "method": "GET",
          "path": {
            "substr": [
              { "var": "temp_data.signed" },
              { "length": [{ "var": "metadata.vars.models_endpoint" }] }
            ]
          },
          "output": "temp_data.mtext",
          "response_format": "text"
        }
      }
    },
    {
      "id": "when_fetch",
      "condition": { "!!": { "var": "temp_data.mtext" } },
      "tasks": [
        {
          "id": "fetch",
          "name": "The manifest, parsed",
          "continue_on_error": true,
          "function": {
            "name": "http_call",
            "input": {
              "connector": "soma-models-http",
              "method": "GET",
              "path": {
                "substr": [
                  { "var": "temp_data.signed" },
                  { "length": [{ "var": "metadata.vars.models_endpoint" }] }
                ]
              },
              "output": "temp_data.man"
            }
          }
        },
        {
          "id": "manifest_ok",
          "name": "Does it hash to what was declared?",
          "function": {
            "name": "db_read",
            "input": {
              "connector": "soma-db",
              "query": { "$sql": "../sql/tb-admit-run-manifest_ok.sql" },
              "params": [{ "var": "temp_data.it.manifest_hash" }, { "var": "temp_data.mtext" }],
              "output": "temp_data.manok"
            }
          }
        }
      ]
    },
    {
      "id": "shape",
      "name": "The registration, rebuilt field by field",
      "condition": { "===": [{ "var": "temp_data.manok.0.ok" }, true] },
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            {
              "path": "temp_data.reg",
              "logic": {
                "abi": { "var": "temp_data.man.abi" },
                "name": { "var": "temp_data.it.model" },
                "version": { "??": [{ "var": "temp_data.man.version" }, "1"] },
                "format": { "??": [{ "var": "temp_data.man.format" }, "onnx"] },
                "description": { "??": [{ "var": "temp_data.man.description" }, ""] },
                "inputs": { "var": "temp_data.man.inputs" },
                "outputs": { "var": "temp_data.man.outputs" },
                "probe_dims": {
                  "??": [
                    { "var": "temp_data.man.probe_dims" },
                    {}
                  ]
                }
              }
            },
            {
              "path": "temp_data.abytes",
              "logic": { "??": [{ "var": "temp_data.head.size" }, 0] }
            },
            {
              "path": "temp_data.reason",
              "logic": {
                "if": [
                  { "var": "temp_data.reason" },
                  { "var": "temp_data.reason" },
                  { "!": { "var": "temp_data.man.inputs" } },
                  "MANIFEST_INVALID",
                  { "!": { "var": "temp_data.man.outputs" } },
                  "MANIFEST_INVALID",
                  null
                ]
              }
            }
          ]
        }
      }
    },
    {
      "id": "reject_result",
      "name": "A manifest may not decode its own head",
      "condition": {
        "and": [{ "!!": { "var": "temp_data.man" } }, { "!!": { "var": "temp_data.man.result" } }]
      },
      "function": {
        "name": "map",
        "input": { "mappings": [{ "path": "temp_data.reason", "logic": "RESULT_NOT_ALLOWED" }] }
      }
    },
    {
      "id": "sift",
      "name": "Can it be queued, and if not whose fault is it?",
      "condition": { "!": { "var": "temp_data.it.job" } },
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            {
              "path": "temp_data.retry",
              "logic": {
                "if": [
                  { "var": "temp_data.retry" },
                  { "var": "temp_data.retry" },
                  { "!": { "var": "temp_data.head" } },
                  "STORE_UNREACHABLE",
                  null
                ]
              }
            },
            {
              "path": "temp_data.reason",
              "logic": {
                "if": [
                  { "var": "temp_data.reason" },
                  { "var": "temp_data.reason" },
                  { "var": "temp_data.retry" },
                  null,
                  { "===": [{ "var": "temp_data.head.exists" }, false] },
                  "ARTIFACT_MISSING",
                  { "!": { "var": "temp_data.man" } },
                  "MANIFEST_MISSING",
                  { "!==": [{ "var": "temp_data.manok.0.ok" }, true] },
                  "MANIFEST_MISMATCH",
                  null
                ]
              }
            }
          ]
        }
      }
    },
    {
      "id": "queue",
      "name": "Queue it for an admitting runner",
      "condition": {
        "and": [
          { "!": { "var": "temp_data.it.job" } },
          { "!!": { "var": "temp_data.reg" } },
          { "!": { "var": "temp_data.reason" } },
          { "!": { "var": "temp_data.retry" } }
        ]
      },
      "function": {
        "name": "db_write",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/tb-admit-run-queue.sql" },
          "params": [
            { "var": "temp_data.it.model_id" },
            { "var": "temp_data.reg" },
            { "var": "temp_data.mtext" },
            { "var": "temp_data.abytes" },
            { "var": "temp_data.it.budget_ops" },
            { "var": "temp_data.token" }
          ],
          "output": "temp_data.queued"
        }
      }
    },
    {
      "id": "sort",
      "name": "Did the report decide anything?",
      "condition": { "!!": { "var": "temp_data.it.job" } },
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            {
              "path": "temp_data.again",
              "logic": {
                "if": [
                  { "var": "temp_data.it.job.again" },
                  { "var": "temp_data.it.job.again" },
                  { "!": { "===": [{ "var": "temp_data.it.job.admitted" }, true] } },
                  null,
                  { "!": { "var": "temp_data.it.job.probe" } },
                  "PROBE_UNREACHABLE",
                  { "===": [{ "var": "temp_data.it.job.opset" }, null] },
                  "REPORT_INCOMPLETE",
                  { "===": [{ "var": "temp_data.it.job.parameters" }, null] },
                  "REPORT_INCOMPLETE",
                  null
                ]
              }
            },
            {
              "path": "temp_data.retry",
              "logic": {
                "if": [{ "!": { "var": "temp_data.it.rules_ok" } }, "SEASON_RULES_INCOMPLETE", null]
              }
            }
          ]
        }
      }
    },
    {
      "id": "classify",
      "name": "Which class does it measure into",
      "condition": {
        "and": [
          { "!!": { "var": "temp_data.it.job" } },
          { "===": [{ "var": "temp_data.it.job.admitted" }, true] }
        ]
      },
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/tb-admit-run-classify.sql" },
          "params": [{ "var": "temp_data.it.model_id" }, { "var": "temp_data.it.job.size" }],
          "output": "temp_data.clsrow"
        }
      }
    },
    {
      "id": "judge",
      "name": "Class, opset, operators and the budget",
      "condition": { "!!": { "var": "temp_data.it.job" } },
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            { "path": "temp_data.cls", "logic": { "var": "temp_data.clsrow.0.cls" } },
            {
              "path": "temp_data.ops",
              "logic": {
                "reduce": [
                  { "var": "temp_data.it.job.operators" },
                  {
                    "allow": { "var": "accumulator.allow" },
                    "bad": {
                      "if": [
                        { "in": [{ "var": "current" }, { "var": "accumulator.allow" }] },
                        { "var": "accumulator.bad" },
                        {
                          "merge": [
                            { "var": "accumulator.bad" },
                            [{ "var": "current" }]
                          ]
                        }
                      ]
                    }
                  },
                  { "allow": { "var": "temp_data.it.op_allowlist" }, "bad": [] }
                ]
              }
            },
            {
              "path": "temp_data.reason",
              "logic": {
                "if": [
                  { "var": "temp_data.again" },
                  null,
                  { "var": "temp_data.retry" },
                  null,
                  { "var": "temp_data.it.job.refused" },
                  { "var": "temp_data.it.job.refused" },
                  { "!": { "===": [{ "var": "temp_data.it.job.admitted" }, true] } },
                  null,
                  {
                    "and": [
                      { "!": { "var": "temp_data.cls" } },
                      { "var": "temp_data.clsrow.0.fits_any" }
                    ]
                  },
                  "CLASS_NOT_OFFERED",
                  { "!": { "var": "temp_data.cls" } },
                  "TOO_LARGE",
                  {
                    "<": [{ "var": "temp_data.it.job.opset" }, { "var": "temp_data.it.opset_min" }]
                  },
                  "OPSET_UNSUPPORTED",
                  {
                    ">": [{ "var": "temp_data.it.job.opset" }, { "var": "temp_data.it.opset_max" }]
                  },
                  "OPSET_UNSUPPORTED",
                  { ">": [{ "length": [{ "var": "temp_data.ops.bad" }] }, 0] },
                  "OP_NOT_ALLOWED",
                  {
                    "and": [
                      { "!!": { "var": "temp_data.it.params_max" } },
                      {
                        ">": [
                          { "var": "temp_data.it.job.parameters" },
                          { "var": "temp_data.it.params_max" }
                        ]
                      }
                    ]
                  },
                  "PARAMS_EXCEEDED",
                  {
                    "and": [
                      { "!": { "var": "temp_data.it.job.probe.ok" } },
                      { "var": "temp_data.it.job.probe.over_budget" }
                    ]
                  },
                  "ADAPTER_OVER_BUDGET",
                  { "!": { "var": "temp_data.it.job.probe.ok" } },
                  { "??": [{ "var": "temp_data.it.job.probe.reason" }, "ADAPTER_INVALID"] },
                  {
                    "and": [
                      { "!!": { "var": "temp_data.it.infer_us_max" } },
                      {
                        ">": [
                          { "var": "temp_data.it.job.probe.infer_us_max" },
                          { "var": "temp_data.it.infer_us_max" }
                        ]
                      }
                    ]
                  },
                  "TOO_SLOW",
                  null
                ]
              }
            }
          ]
        }
      }
    },
    {
      "id": "verify",
      "name": "testing -> verified (a baseline: disabled)",
      "condition": {
        "and": [
          { "!!": { "var": "temp_data.it.job" } },
          { "===": [{ "var": "temp_data.it.job.admitted" }, true] },
          { "!!": { "var": "temp_data.cls" } },
          { "!": { "var": "temp_data.reason" } },
          { "!": { "var": "temp_data.again" } },
          { "!": { "var": "temp_data.retry" } }
        ]
      },
      "function": {
        "name": "db_write",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/tb-admit-run-verify.sql" },
          "params": [
            { "var": "temp_data.it.model_id" },
            { "var": "temp_data.cls" },
            { "var": "temp_data.it.job.size" },
            { "var": "temp_data.it.job.parameters" },
            { "var": "temp_data.it.job.probe.infer_us_max" },
            { "var": "metadata.vars.orion_version" },
            { "var": "temp_data.token" },
            { "var": "temp_data.it.job.probe_dims" }
          ],
          "output": "temp_data.verified"
        }
      }
    },
    {
      "id": "reject",
      "name": "Reject, with the word a competitor reads",
      "condition": { "!!": { "var": "temp_data.reason" } },
      "function": {
        "name": "db_write",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/tb-admit-run-reject.sql" },
          "params": [
            { "var": "temp_data.it.model_id" },
            { "var": "temp_data.reason" },
            { "var": "temp_data.token" }
          ],
          "output": "temp_data.rejected"
        }
      }
    },
    {
      "id": "requeue",
      "name": "Send the report back to the queue",
      "condition": {
        "and": [{ "!!": { "var": "temp_data.it.job" } }, { "!!": { "var": "temp_data.again" } }]
      },
      "function": {
        "name": "db_write",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/tb-admit-run-requeue.sql" },
          "params": [
            { "var": "temp_data.it.model_id" },
            { "var": "temp_data.token" },
            { "var": "temp_data.again" }
          ],
          "output": "temp_data.requeued"
        }
      }
    },
    {
      "id": "release",
      "name": "Release the clock's claim",
      "function": {
        "name": "db_write",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/tb-admit-run-release.sql" },
          "params": [{ "var": "temp_data.it.model_id" }, { "var": "temp_data.token" }],
          "output": "temp_data.released"
        }
      }
    },
    {
      "id": "notify",
      "name": "Tell the owner the verdict",
      "condition": {
        "and": [
          { "!": { "var": "temp_data.retry" } },
          { "!": { "var": "temp_data.again" } },
          {
            "or": [{ "!!": { "var": "temp_data.it.job" } }, { "!!": { "var": "temp_data.reason" } }]
          }
        ]
      },
      "continue_on_error": true,
      "function": {
        "name": "db_write",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/tb-shared-notify.sql" },
          "params": [{ "var": "temp_data.it.model_id" }],
          "output": "temp_data.notified"
        }
      }
    }
  ]
}
