{
  "workflow_id": "soma-seasons-close",
  "name": "Ask for the live season to close",
  "tags": [
    "pkg:soma"
  ],
  "condition": true,
  "description": "Layer 06 §5.2, admin only. Writes an INTENT -- close_requested_at on the live season -- which the close, withdraw's second task, consumes within the minute: it rejects the versions still waiting SEASON_CLOSED, cancels the queue, leaves in-flight matches to finish and count, and sets closed_at. An intent rather than the close itself keeps one copy of the close, in the package whose check-sql.sh checks it. 202 with the season as it stands; 409 when the game has no live season or the request was already made.",
  "tasks": [
    {
      "id": "who",
      "name": "Who is asking",
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": "SELECT json_build_object('id', u.id, 'role', u.role) AS body FROM users u JOIN live_sessions s ON s.user_id = u.id AND s.sid = ($2)::uuid WHERE u.id = ($1)::uuid",
          "params": [
            {
              "var": "metadata.auth.claims.sub"
            },
            {
              "var": "metadata.auth.claims.sid"
            }
          ],
          "output": "temp_data.who"
        }
      }
    },
    {
      "id": "deny",
      "name": "Reject a revoked session",
      "condition": {
        "!": {
          "var": "temp_data.who.0.body"
        }
      },
      "terminal": true,
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            {
              "path": "data.body",
              "logic": {
                "error": "session_revoked"
              }
            },
            {
              "path": "data._orion.response",
              "logic": {
                "status": 401,
                "body_path": "data.body"
              }
            }
          ]
        }
      }
    },
    {
      "id": "forbid",
      "name": "Admins only",
      "condition": {
        "!=": [
          {
            "var": "temp_data.who.0.body.role"
          },
          "admin"
        ]
      },
      "terminal": true,
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            {
              "path": "data.body",
              "logic": {
                "error": "admin_only"
              }
            },
            {
              "path": "data._orion.response",
              "logic": {
                "status": 403,
                "body_path": "data.body"
              }
            }
          ]
        }
      },
      "description": "users.role = 'admin' exists since the initial schema and this is the first thing that reads it. The role is read off the live session, not off a claim in the cookie, so revoking a session or demoting a user takes effect on the next request."
    },
    {
      "id": "request",
      "name": "Record the request",
      "function": {
        "name": "db_write",
        "input": {
          "connector": "soma-db",
          "query": "UPDATE seasons s SET close_requested_at = now() FROM games g WHERE g.id = s.game_id AND g.slug = ($1)::text AND s.closed_at IS NULL AND s.close_requested_at IS NULL",
          "params": [
            {
              "var": "metadata.params.game"
            }
          ],
          "output": "temp_data.requested"
        }
      }
    },
    {
      "id": "refused",
      "name": "Nothing to close",
      "terminal": true,
      "condition": {
        "!": {
          ">": [
            {
              "var": "temp_data.requested.rows_affected"
            },
            0
          ]
        }
      },
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            {
              "path": "data.body",
              "logic": {
                "error": "no_live_season"
              }
            },
            {
              "path": "data._orion.response",
              "logic": {
                "status": 409,
                "body_path": "data.body"
              }
            }
          ]
        }
      }
    },
    {
      "id": "read",
      "name": "Read the season back",
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": "SELECT season_json(s) AS body FROM seasons s JOIN games g ON g.id = s.game_id WHERE g.slug = ($1)::text ORDER BY (s.closed_at IS NULL) DESC, s.number DESC LIMIT 1",
          "params": [
            {
              "var": "metadata.params.game"
            }
          ],
          "output": "temp_data.rows"
        }
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            {
              "path": "data.body",
              "logic": {
                "var": "temp_data.rows.0.body"
              }
            },
            {
              "path": "data._orion.response",
              "logic": {
                "status": 202,
                "body_path": "data.body"
              }
            }
          ]
        }
      }
    }
  ]
}
