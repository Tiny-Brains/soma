{
  "workflow_id": "soma-pub-posts-get",
  "name": "One post",
  "description": "One published post, whole, by its slug. A draft, an unpublished post and a slug that was renamed answer 404: the slug is editable, so a link to an old one is a link to nothing. An admin previews a draft through GET /v1/admin/posts/{id}.",
  "tags": ["soma", "pub", "community"],
  "tasks": [
    {
      "id": "query",
      "name": "Query",
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-pub-posts-get-query.sql" },
          "params": [{ "var": "metadata.params.slug" }],
          "output": "temp_data.rows"
        }
      }
    },
    {
      "id": "missing",
      "use": "refuse",
      "with": {
        "when": { "!": { "var": "temp_data.rows.0.body" } },
        "status": 404,
        "body": { "error": "unknown_post" },
        "name": "No such post"
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            { "path": "data.body", "logic": { "var": "temp_data.rows.0.body" } },
            { "path": "data._orion.response", "logic": { "$from": "constants.ok" } }
          ]
        }
      }
    }
  ]
}
