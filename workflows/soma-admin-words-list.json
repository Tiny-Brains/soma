{
  "workflow_id": "soma-admin-words-list",
  "name": "The word list",
  "description": "Admin only: THE WORDS text_hold_tag() holds a comment or a story on and refuses a bio or a note for, alphabetically, each with who added it and when. Matched whole and case-blind; a word may be a phrase. A change applies to the next text, never to the ones already through.",
  "tags": ["soma", "admin", "community"],
  "tasks": [
    {
      "id": "admin",
      "use": "admin-only"
    },
    {
      "id": "query",
      "name": "Query",
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-admin-words-list-query.sql" },
          "params": [{ "var": "metadata.auth.claims.sub" }, { "var": "metadata.auth.claims.sid" }],
          "output": "temp_data.rows"
        }
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            { "path": "data.body", "logic": { "var": "temp_data.rows.0.body" } },
            { "path": "data._orion.response", "logic": { "$from": "constants.ok" } }
          ]
        }
      }
    }
  ]
}
