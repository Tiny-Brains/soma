{
  "workflow_id": "soma-pub-maps-get",
  "name": "One season map",
  "description": "PUBLIC: one board of a season, with the board itself and every time it was enabled or disabled -- which is the record of when it was in play, since a live season's standings were earned on whatever was enabled at the time. The board is returned exactly as stored, for the viewer's own component to draw; nothing here reads inside it.",
  "tags": ["soma", "pub", "maps"],
  "tasks": [
    {
      "id": "query",
      "name": "Query",
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-pub-maps-get-query.sql" },
          "params": [
            { "var": "metadata.params.game" },
            { "var": "metadata.params.slug" },
            { "var": "metadata.params.map_id" }
          ],
          "output": "temp_data.rows"
        }
      }
    },
    {
      "id": "unknown",
      "use": "refuse",
      "with": {
        "when": { "!": { "var": "temp_data.rows.0.body" } },
        "status": 404,
        "body": { "error": "unknown_map" },
        "name": "No such map"
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            { "path": "data.body", "logic": { "var": "temp_data.rows.0.body" } },
            { "path": "data._orion.response", "logic": { "$from": "constants.ok" } }
          ]
        }
      }
    }
  ]
}
