{
  "workflow_id": "soma-user-me-update",
  "name": "Edit your own profile",
  "description": "The two fields a competitor may change: the display name and the bio. The handle is not among them -- it is GitHub's, it is the profile's URL, and it is re-read on every sign-in. A key the body leaves out is kept; a key sent empty or blank clears it to null rather than storing a name made of spaces, and the profile then falls back to the handle. THE BIO IS REFUSED, NOT HELD, on a listed word (text_hold_tag): a 422 names the word and the competitor rewrites one line rather than waiting on an admin. A URL in it is allowed and drawn as plain text. The UPDATE joins live_sessions so a revoked session cannot write, and the row is read back so the response is what was stored rather than what was sent.",
  "tags": ["soma", "user", "profile"],
  "tasks": [
    {
      "id": "parse",
      "name": "Parse payload",
      "function": { "name": "parse_json", "input": { "source": "payload", "target": "req" } }
    },
    {
      "id": "toolong",
      "use": "refuse",
      "with": {
        "when": {
          ">": [
            {
              "length": [
                { "or": [{ "var": "data.req.display_name" }, ""] }
              ]
            },
            60
          ]
        },
        "status": 400,
        "body": {
          "error": "display_name_too_long",
          "detail": "A display name is at most 60 characters. It is what people see beside your handle, not a biography."
        },
        "name": "Refuse an unusable name"
      }
    },
    {
      "id": "biotoolong",
      "use": "refuse",
      "with": {
        "when": {
          ">": [
            {
              "length": [
                { "or": [{ "var": "data.req.bio" }, ""] }
              ]
            },
            160
          ]
        },
        "status": 400,
        "body": {
          "error": "bio_too_long",
          "detail": "A bio is one line of at most 160 characters."
        },
        "name": "Refuse a bio too long"
      }
    },
    {
      "id": "update",
      "name": "Update",
      "function": {
        "name": "db_write",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-user-me-update-update.sql" },
          "params": [
            { "var": "metadata.auth.claims.sub" },
            { "var": "metadata.auth.claims.sid" },
            { "var": "data.req" }
          ],
          "output": "temp_data.updated"
        }
      }
    },
    {
      "id": "read",
      "name": "Read it back",
      "function": {
        "name": "db_read",
        "input": {
          "connector": "soma-db",
          "query": { "$sql": "../sql/soma-user-me-update-read.sql" },
          "params": [
            { "var": "metadata.auth.claims.sub" },
            { "var": "metadata.auth.claims.sid" },
            { "var": "data.req" }
          ],
          "output": "temp_data.rows"
        }
      }
    },
    {
      "id": "deny",
      "use": "deny-revoked",
      "with": { "row": "temp_data.rows.0.session_ok" }
    },
    {
      "id": "word",
      "use": "refuse",
      "with": {
        "when": { "!!": { "var": "temp_data.rows.0.bio_word" } },
        "status": 422,
        "body": {
          "error": "bio_word_listed",
          "word": { "var": "temp_data.rows.0.bio_word" },
          "detail": "The bio uses a word the site does not allow. Nothing was changed."
        },
        "name": "Refuse a listed word",
        "description": "Reached after deny, so a signed-out caller is told 401 and never which word."
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "function": {
        "name": "map",
        "input": {
          "mappings": [
            { "path": "data.body", "logic": { "var": "temp_data.rows.0.body" } },
            { "path": "data._orion.response", "logic": { "$from": "constants.ok" } }
          ]
        }
      }
    }
  ]
}
