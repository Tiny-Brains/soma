{
  "constants": {
    "session_auth": {
      "mode": "jwt",
      "algorithms": ["HS256"],
      "jwt_keys": [{ "algorithm": "HS256", "key": "env://SOMA_SESSION_SECRET" }],
      "issuer": "soma",
      "source": { "cookie": "soma_session" }
    },
    "runner_auth": {
      "mode": "jwt",
      "algorithms": ["HS256"],
      "jwt_keys": [{ "algorithm": "HS256", "key": "env://RUNNER_TOKEN_SECRET" }],
      "issuer": "soma",
      "audience": "runner",
      "source": { "header": "Authorization", "scheme": "Bearer " }
    },
    "shaped": { "mode": "shaped" },
    "public_rate": {
      "requests_per_second": "var://rate_public_rps",
      "burst": "var://rate_public_burst"
    },
    "session_rate": {
      "requests_per_second": "var://rate_session_rps",
      "burst": "var://rate_session_burst"
    },
    "per_user_read_rate": {
      "requests_per_second": "var://rate_per_user_read_rps",
      "burst": "var://rate_per_user_read_burst",
      "key_logic": { "var": "auth.sub" }
    },
    "per_user_write_rate": {
      "requests_per_second": "var://rate_per_user_write_rps",
      "burst": "var://rate_per_user_write_burst",
      "key_logic": { "var": "auth.sub" }
    },
    "per_admin_board_rate": {
      "requests_per_second": "var://rate_per_admin_board_rps",
      "burst": "var://rate_per_admin_board_burst",
      "key_logic": { "var": "auth.sub" }
    },
    "runner_rate": {
      "requests_per_second": "var://rate_runner_rps",
      "burst": "var://rate_runner_burst"
    },
    "runner_token_rate": {
      "requests_per_second": "var://rate_runner_token_rps",
      "burst": "var://rate_runner_token_burst"
    },
    "per_runner_rate": {
      "requests_per_second": "var://rate_per_runner_rps",
      "burst": "var://rate_per_runner_burst",
      "key_logic": { "var": "auth.sub" }
    },
    "hot_cache": {
      "enabled": true,
      "ttl_secs": "var://hot_cache_ttl_secs",
      "connector": "soma-cache",
      "coalesce_misses": true
    },
    "season_cache": {
      "enabled": true,
      "ttl_secs": "var://season_cache_ttl_secs",
      "connector": "soma-cache",
      "coalesce_misses": true
    },
    "ok": { "status": 200, "body_path": "data.body" },
    "created": { "status": 201, "body_path": "data.body" },
    "no_content": { "status": 204 },
    "admin_identity": {
      "connector": "soma-db",
      "query": "SELECT json_build_object('id', u.id, 'role', u.role) AS body FROM users u JOIN live_sessions s ON s.user_id = u.id AND s.sid = ($2)::uuid WHERE u.id = ($1)::uuid",
      "params": [{ "var": "metadata.auth.claims.sub" }, { "var": "metadata.auth.claims.sid" }],
      "output": "temp_data.who"
    },
    "season_admin_identity": {
      "connector": "soma-db",
      "query": "SELECT json_build_object('id', u.id, 'role', u.role, 'season_id', se.id, 'scope', CASE WHEN u.role = 'admin' THEN 'platform' WHEN sa.user_id IS NOT NULL THEN 'season' END, 'closed', se.closed_at IS NOT NULL, 'slug', se.slug) AS body FROM users u JOIN live_sessions s ON s.user_id = u.id AND s.sid = ($2)::uuid LEFT JOIN games g ON g.slug = ($3)::text LEFT JOIN seasons se ON se.game_id = g.id AND se.slug = ($4)::text AND season_visible(se, u.id) LEFT JOIN season_admins sa ON sa.season_id = se.id AND sa.user_id = u.id AND sa.removed_at IS NULL WHERE u.id = ($1)::uuid",
      "params": [
        { "var": "metadata.auth.claims.sub" },
        { "var": "metadata.auth.claims.sid" },
        { "var": "metadata.params.game" },
        { "var": "metadata.params.slug" }
      ],
      "output": "temp_data.who"
    },
    "clock_tracing": { "errors_only": true, "task_details": true },
    "loop_clock_tracing": { "errors_only": true, "task_details": false },
    "gate_tracing": { "errors_only": true, "task_details": false },
    "host_required": {
      "error": "host_required",
      "detail": "Name exactly one host: `match` or `model`."
    },
    "payload_body": { "body_mode": "payload" },
    "dedup": { "header": "Idempotency-Key", "window_secs": 300, "connector": "soma-cache" }
  },
  "fragments": {
    "refuse": {
      "params": {
        "when": {},
        "status": {},
        "body": {},
        "name": { "default": "Refuse" },
        "description": { "default": "" },
        "headers": { "default": {} }
      },
      "tasks": [
        {
          "id": "answer",
          "name": { "$param": "name" },
          "description": { "$param": "description" },
          "condition": { "$param": "when" },
          "terminal": true,
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                { "path": "data.body", "logic": { "$param": "body" } },
                {
                  "path": "data._orion.response",
                  "logic": {
                    "status": { "$param": "status" },
                    "body_path": "data.body",
                    "headers": { "$param": "headers" }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "deny-revoked": {
      "params": { "row": {} },
      "tasks": [
        {
          "id": "revoked",
          "name": "Reject a revoked session",
          "description": "The session guard is a JOIN, not a task: an authed read joins live_sessions and answers nothing when the row is gone. This is the half that turns that absence into a 401 rather than an empty 200. It must stay AFTER the read that produces the row and BEFORE the respond, which is where the call site puts it.",
          "condition": { "!": { "var": { "$param": "row" } } },
          "terminal": true,
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                { "path": "data.body", "logic": { "error": "session_revoked" } },
                {
                  "path": "data._orion.response",
                  "logic": { "status": 401, "body_path": "data.body" }
                }
              ]
            }
          }
        }
      ]
    },
    "admin-only": {
      "tasks": [
        {
          "id": "who",
          "name": "Who is asking",
          "function": { "name": "db_read", "input": { "$from": "constants.admin_identity" } }
        },
        {
          "id": "revoked",
          "name": "Reject a revoked session",
          "description": "The session guard is the JOIN in admin_identity: no row is a revoked or missing session, answered 401.",
          "condition": { "!": { "var": "temp_data.who.0.body" } },
          "terminal": true,
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                { "path": "data.body", "logic": { "error": "session_revoked" } },
                {
                  "path": "data._orion.response",
                  "logic": { "status": 401, "body_path": "data.body" }
                }
              ]
            }
          }
        },
        {
          "id": "forbid",
          "name": "Admins only",
          "description": "The role is read off the live session rather than off a claim in the cookie, so revoking a session or demoting a user takes effect on the next request.",
          "condition": { "!=": [{ "var": "temp_data.who.0.body.role" }, "admin"] },
          "terminal": true,
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                { "path": "data.body", "logic": { "error": "admin_only" } },
                {
                  "path": "data._orion.response",
                  "logic": { "status": 403, "body_path": "data.body" }
                }
              ]
            }
          }
        }
      ]
    },
    "season-admin-only": {
      "tasks": [
        {
          "id": "who",
          "name": "Who is asking, and for which season",
          "description": "season_admin_identity reads the live session AND resolves the season from the route's {game}/{slug}, and records the caller's scope: 'platform' for a platform admin (who may touch any season), 'season' for a live member of season_admins of THIS season, or null for anyone else. Membership is read off the row on every request, like admin-only's role, so removing a season admin takes effect at the next call. A route whose answer differs by scope reads temp_data.who.0.body.scope.",
          "function": { "name": "db_read", "input": { "$from": "constants.season_admin_identity" } }
        },
        {
          "id": "revoked",
          "name": "Reject a revoked session",
          "description": "No row is a revoked or missing session (the JOIN on live_sessions), answered 401 before anything about the season is revealed.",
          "condition": { "!": { "var": "temp_data.who.0.body" } },
          "terminal": true,
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                { "path": "data.body", "logic": { "error": "session_revoked" } },
                {
                  "path": "data._orion.response",
                  "logic": { "status": 401, "body_path": "data.body" }
                }
              ]
            }
          }
        },
        {
          "id": "unknown_season",
          "name": "Reject an unknown game or season",
          "description": "A live session but no such {game}/{slug} -- or a private season the caller may not see (season_visible, in season_admin_identity's join) -- is 404, told apart from the 403 below only for a season the caller can already see, so nobody maps which private seasons exist by the status code.",
          "condition": {
            "and": [
              { "!!": { "var": "temp_data.who.0.body" } },
              { "!": { "var": "temp_data.who.0.body.season_id" } }
            ]
          },
          "terminal": true,
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                { "path": "data.body", "logic": { "error": "unknown_season" } },
                {
                  "path": "data._orion.response",
                  "logic": { "status": 404, "body_path": "data.body" }
                }
              ]
            }
          }
        },
        {
          "id": "forbid",
          "name": "This season's admins only",
          "description": "The season exists but the caller is neither a platform admin nor a live member of it: 403. scope is read off the live row, so a removed season admin is refused on the next call.",
          "condition": { "!": { "var": "temp_data.who.0.body.scope" } },
          "terminal": true,
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                { "path": "data.body", "logic": { "error": "season_admin_only" } },
                {
                  "path": "data._orion.response",
                  "logic": { "status": 403, "body_path": "data.body" }
                }
              ]
            }
          }
        }
      ]
    },
    "invalidate": {
      "params": { "namespaces": {}, "when": { "default": true } },
      "tasks": [
        {
          "id": "bump",
          "name": "Invalidate the response cache",
          "description": "The write-side half of a cached route's `cache.namespaces`: one INCR per namespace, in the same run as the write that made the entries stale, AFTER it and only when it moved rows. continue_on_error, because the write has committed and a bump that cannot reach a store must not fail it; the channel's ttl_secs is then the ceiling on what that store still serves.",
          "condition": { "$param": "when" },
          "continue_on_error": true,
          "function": {
            "name": "cache_invalidate",
            "input": { "namespaces": { "$param": "namespaces" } }
          }
        }
      ]
    },
    "require-claim-token": {
      "tasks": [
        {
          "id": "parse",
          "name": "Parse payload",
          "function": { "name": "parse_json", "input": { "source": "payload", "target": "req" } }
        },
        {
          "id": "declared",
          "name": "A claim token, declared",
          "description": "Every fenced statement binds `claim_token`, and a body without one (or with the field misnamed) bound NULL, moved no row and answered 409 claim_lost -- which names the one thing that was right, and sends a healthy but misconfigured runner into claim-again loops (a report goes back to the queue until the submission expires). A missing token is a 400 with its name, before any statement runs.",
          "condition": { "!": { "var": "data.req.claim_token" } },
          "terminal": true,
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                { "path": "data.body", "logic": { "error": "claim_token_required" } },
                {
                  "path": "data._orion.response",
                  "logic": { "status": 400, "body_path": "data.body" }
                }
              ]
            }
          }
        }
      ]
    },
    "sign-uploads": {
      "tasks": [
        {
          "id": "sign",
          "name": "Sign both uploads",
          "description": "Both presigns are asked the same question -- is there a testing version to upload to -- so the group carries the condition once and the two steps inside carry none. Neither writes what it reads, so one evaluation is the whole answer. One fragment: a competitor's submission and an admin's baseline upload sign the same two keys the admit clock fetches.",
          "condition": { "!!": { "var": "temp_data.rows.0.body.version_id" } },
          "tasks": [
            {
              "id": "sign_weights",
              "name": "A one-shot PUT for the ONNX graph",
              "function": {
                "name": "storage_presign",
                "input": {
                  "connector": "soma-models",
                  "method": "PUT",
                  "key": {
                    "cat": [
                      "models/",
                      { "var": "temp_data.rows.0.body.version_id" },
                      "/",
                      "model.onnx"
                    ]
                  },
                  "expires_in": { "var": "temp_data.rows.0.upload_s" },
                  "output": "temp_data.put_weights"
                }
              }
            },
            {
              "id": "sign_manifest",
              "name": "A one-shot PUT for the manifest",
              "function": {
                "name": "storage_presign",
                "input": {
                  "connector": "soma-models",
                  "method": "PUT",
                  "key": {
                    "cat": [
                      "models/",
                      { "var": "temp_data.rows.0.body.version_id" },
                      "/",
                      "manifest.json"
                    ]
                  },
                  "expires_in": { "var": "temp_data.rows.0.upload_s" },
                  "output": "temp_data.put_manifest"
                }
              }
            }
          ]
        }
      ]
    },
    "notify-comments": {
      "params": {
        "when": {},
        "comment": {},
        "ids": {},
        "description": {
          "default": "Only after a write that decided something. Each notifier is its own continue_on_error statement that reads the comment off its row, sends nothing for a held one, and may fail without failing the write."
        },
        "name": { "default": "Tell whom it concerns" }
      },
      "tasks": [
        {
          "id": "notify",
          "name": { "$param": "name" },
          "description": { "$param": "description" },
          "condition": { "$param": "when" },
          "tasks": [
            {
              "id": "notify_reply",
              "name": "Tell the parent's author",
              "continue_on_error": true,
              "function": {
                "name": "db_write",
                "input": {
                  "connector": "soma-db",
                  "query": { "$sql": "../sql/soma-community-shared-notify_reply.sql" },
                  "params": [{ "$param": "comment" }, { "$param": "ids" }],
                  "output": "temp_data.notified_reply"
                }
              }
            },
            {
              "id": "notify_comment",
              "name": "Tell the host's owners",
              "continue_on_error": true,
              "function": {
                "name": "db_write",
                "input": {
                  "connector": "soma-db",
                  "query": { "$sql": "../sql/soma-community-shared-notify_comment.sql" },
                  "params": [{ "$param": "comment" }, { "$param": "ids" }],
                  "output": "temp_data.notified_comment"
                }
              }
            }
          ]
        }
      ]
    },
    "none_written": {
      "params": { "slot": {} },
      "value": { "!": { ">": [{ "var": "temp_data.{{slot}}.rows_affected" }, 0] } }
    },
    "generation": {
      "params": { "path": { "default": "temp_data.gen.0" } },
      "tasks": [
        {
          "id": "zero",
          "name": "A missing generation is zero",
          "description": "The MGET before this may have read a generation that does not exist yet: nothing has bumped it since the cache Redis was empty (a fresh stack, a restart, a flush). That is generation zero, not \"do not cache\": the first bump makes it one, so a marker or entry written under zero is stale the moment anything happens, and until then the idle answer is as safe as under any other value. Left out, a fresh node polls Postgres on every claim and every count tick until the first admission or finish, which is how the before-and-after measurement found it. Materialised here because cache_write folds only a plain var in its value.",
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                {
                  "path": "temp_data.generation",
                  "logic": { "??": [{ "var": { "$param": "path" } }, 0] }
                }
              ]
            }
          }
        }
      ]
    },
    "too-long": {
      "params": {
        "field": {},
        "max": {},
        "error": {},
        "detail": {},
        "name": { "default": "Too long" }
      },
      "tasks": [
        {
          "id": "answer",
          "use": "refuse",
          "with": {
            "when": {
              ">": [
                {
                  "length": [
                    { "or": [{ "var": "data.req.{{field}}" }, ""] }
                  ]
                },
                { "$param": "max" }
              ]
            },
            "status": 400,
            "body": { "error": { "$param": "error" }, "detail": { "$param": "detail" } },
            "name": { "$param": "name" }
          }
        }
      ]
    },
    "not-bool": {
      "params": {
        "field": {},
        "error": {},
        "detail": {},
        "name": { "default": "A boolean, stated" }
      },
      "tasks": [
        {
          "id": "answer",
          "use": "refuse",
          "with": {
            "when": {
              "and": [
                { "!==": [{ "var": "data.req.{{field}}" }, true] },
                { "!==": [{ "var": "data.req.{{field}}" }, false] }
              ]
            },
            "status": 400,
            "body": { "error": { "$param": "error" }, "detail": { "$param": "detail" } },
            "name": { "$param": "name" }
          }
        }
      ]
    },
    "bump": {
      "params": { "key": {}, "when": { "default": true }, "soft": { "default": true } },
      "tasks": [
        {
          "id": "bump",
          "name": "Move a generation",
          "description": "One INCRBY on soma-cache under a generation key, AFTER the write that made new work and only when it moved rows: every idle marker that embeds the old value stops matching. continue_on_error, because the write has committed and a Redis that cannot be reached must not fail it; the markers' TTLs are then the ceiling. No output: nothing reads the number back. `soft: false` is the revocation form (gen:sess:<user>): a bump that cannot reach Redis then fails the request, because a revocation that silently did not hold is worse than a retry.",
          "condition": { "$param": "when" },
          "continue_on_error": { "$param": "soft" },
          "function": {
            "name": "cache_incr",
            "input": { "connector": "soma-cache", "key": { "$param": "key" } }
          }
        }
      ]
    },
    "season-not-closed": {
      "tasks": [
        {
          "id": "closed",
          "name": "Not once the season has closed",
          "description": "After season-admin-only: a season admin's writes to the season's roster and runners stop at its close, whose standings are final. Reads go on.",
          "condition": { "var": "temp_data.who.0.body.closed" },
          "terminal": true,
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                {
                  "path": "data.body",
                  "logic": {
                    "error": "season_closed",
                    "detail": "The season has closed: its participants, admins and runners are fixed."
                  }
                },
                {
                  "path": "data._orion.response",
                  "logic": { "status": 409, "body_path": "data.body" }
                }
              ]
            }
          }
        }
      ]
    },
    "season-runner-keys-answer": {
      "tasks": [
        {
          "id": "read",
          "name": "Read the season's keys",
          "function": {
            "name": "db_read",
            "input": {
              "connector": "soma-db",
              "query": { "$sql": "../sql/soma-user-shared-season-runner-keys.sql" },
              "params": [{ "var": "temp_data.who.0.body.season_id" }],
              "output": "temp_data.rows"
            }
          }
        },
        {
          "id": "respond",
          "name": "Respond",
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                { "path": "data.body", "logic": { "var": "temp_data.rows.0.body" } },
                { "path": "data._orion.response", "logic": { "$from": "constants.ok" } }
              ]
            }
          }
        }
      ]
    },
    "match-answer": {
      "tasks": [
        {
          "id": "presign",
          "name": "Sign the replay URL",
          "condition": { "!!": { "var": "temp_data.rows.0.replay_key" } },
          "function": {
            "name": "storage_presign",
            "input": {
              "connector": "soma-blobs",
              "method": "GET",
              "key": { "var": "temp_data.rows.0.replay_key" },
              "expires_in": "1h",
              "output": "temp_data.replay_url"
            }
          }
        },
        {
          "id": "respond",
          "name": "Respond",
          "function": {
            "name": "map",
            "input": {
              "mappings": [
                { "path": "data.body", "logic": { "var": "temp_data.rows.0.body" } },
                { "path": "data.body.replay_url", "logic": { "var": "temp_data.replay_url" } },
                { "path": "data._orion.response", "logic": { "$from": "constants.ok" } }
              ]
            }
          }
        }
      ]
    },
    "submission-refusals": {
      "tasks": [
        {
          "id": "revoked",
          "use": "refuse",
          "with": {
            "when": {
              "and": [
                { "$use": "none_written", "with": { "slot": "insert" } },
                { "===": [{ "var": "temp_data.why.0.session_ok" }, false] }
              ]
            },
            "status": 401,
            "body": { "error": "session_revoked" },
            "name": "A live session first",
            "description": "The write joined live_sessions and wrote nothing, and the why says the session is gone: 401, before any reason the same absence could be mistaken for. `===` false, so a why that returned no row (an unknown game) answers its own refusal instead."
          }
        },
        {
          "id": "note_refused",
          "use": "refuse",
          "with": {
            "when": {
              "and": [
                { "$use": "none_written", "with": { "slot": "insert" } },
                { "!!": { "var": "temp_data.why.0.body.note_word" } }
              ]
            },
            "status": 422,
            "body": {
              "error": "note_word_listed",
              "word": { "var": "temp_data.why.0.body.note_word" },
              "detail": "The note uses a word the site does not allow. Nothing was submitted."
            },
            "name": "Refuse a listed word",
            "description": "The insert refuses a note carrying a listed word (text_hold_tag) in its own predicate, and `why` names the word. Refused rather than held: a note is public text beside the version, so the competitor rewrites one line. A URL is allowed."
          }
        },
        {
          "id": "unknown_model",
          "use": "refuse",
          "with": {
            "when": {
              "and": [
                { "$use": "none_written", "with": { "slot": "insert" } },
                { "!": { "var": "temp_data.why.0.body.model" } },
                { "!!": { "var": "temp_data.why.0.body" } }
              ]
            },
            "status": 404,
            "body": { "error": "unknown_model", "detail": { "var": "data.req.model" } },
            "name": "No such model",
            "description": "A submission names a model the caller does not own, or does not have: 404 and not 409, because nothing about the season refused it. Entries are created explicitly -- a repository with no entry behind it is not silently adopted, or a typo in a repo path would quietly start a second lineage with its own version numbers."
          }
        },
        {
          "id": "refused",
          "use": "refuse",
          "with": {
            "when": {
              "and": [
                { "$use": "none_written", "with": { "slot": "insert" } },
                { "!!": { "var": "temp_data.why.0.body.model" } },
                {
                  "or": [
                    { "!=": [{ "var": "temp_data.why.0.body.state" }, "open"] },
                    { "!": { "var": "temp_data.why.0.body.participant" } },
                    { "!": { "var": "temp_data.why.0.body.entry_room" } },
                    { "!!": { "var": "temp_data.why.0.body.model.retired" } },
                    {
                      "and": [
                        { "!!": { "var": "temp_data.why.0.body.entry_in_flight" } },
                        { "!": { "var": "temp_data.why.0.body.same_submission" } }
                      ]
                    },
                    { "!": { "var": "temp_data.why.0.body.in_flight_ok" } },
                    { "!": { "var": "temp_data.why.0.body.versions_ok" } },
                    {
                      "and": [
                        { "!!": { "var": "temp_data.why.0.body.cooldown_until" } },
                        { ">": [{ "var": "temp_data.why.0.body.cooldown_until" }, { "now": [] }] }
                      ]
                    },
                    { "!": { "var": "temp_data.why.0.body.unique_weights" } }
                  ]
                }
              ]
            },
            "status": 409,
            "body": {
              "error": {
                "if": [
                  { "!=": [{ "var": "temp_data.why.0.body.state" }, "open"] },
                  "season_not_open",
                  { "!!": { "var": "temp_data.why.0.body.season_admin" } },
                  "season_admin_cannot_enter",
                  { "!": { "var": "temp_data.why.0.body.participant" } },
                  "not_a_participant",
                  { "!": { "var": "temp_data.why.0.body.entry_room" } },
                  "entries_max",
                  { "!!": { "var": "temp_data.why.0.body.model.retired" } },
                  "model_retired",
                  {
                    "and": [
                      { "!!": { "var": "temp_data.why.0.body.entry_in_flight" } },
                      { "!": { "var": "temp_data.why.0.body.same_submission" } }
                    ]
                  },
                  "version_in_flight",
                  { "!": { "var": "temp_data.why.0.body.in_flight_ok" } },
                  "too_many_in_flight",
                  { "!": { "var": "temp_data.why.0.body.versions_ok" } },
                  "too_many_versions",
                  {
                    "and": [
                      { "!!": { "var": "temp_data.why.0.body.cooldown_until" } },
                      { ">": [{ "var": "temp_data.why.0.body.cooldown_until" }, { "now": [] }] }
                    ]
                  },
                  "cooling_down",
                  "weights_already_entered"
                ]
              },
              "detail": { "var": "temp_data.why.0.body" }
            },
            "name": "Refused by the season",
            "description": "`entry_in_flight` refuses only a DIFFERENT submission. Re-POSTing the SAME two hashes for the row already in flight falls through to fetch + sign and answers with fresh upload URLs, good for what is left of the version's upload window, so a competitor who lost the first pair can still finish the version. Past the window `same_submission` is false and the same hashes are `version_in_flight`: the admit clock is about to reject the empty version, and the POST after that is a new one."
          }
        }
      ]
    }
  }
}
